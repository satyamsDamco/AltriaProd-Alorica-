<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Contact_found</name>
        <label>Contact found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>inputIssueRecord.ContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Link_Contact_to_Messaging_End_User</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Have_MessagingSessionToAssociate</name>
        <label>Have MessagingSessionToAssociate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Associate_Messaging</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>MessagingSessionToAssociate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateMessagingSession</targetReference>
            </connector>
            <label>Associate Messaging</label>
        </rules>
    </decisions>
    <decisions>
        <name>InputIssueIdCheck</name>
        <label>InputIssueIdCheck</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Have_Issue_Id</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>inputIssueId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetIssueRecord</targetReference>
            </connector>
            <label>Have Issue Id</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check the entered Issue if not Null</description>
        <name>InputIssueRecordCheck</name>
        <label>InputIssueRecordCheck</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>InputIssueIdCheck</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Have_Issue_Record</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>inputIssueRecord</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetMessagingSessionRecord</targetReference>
            </connector>
            <label>Have Issue Record</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if the issue was already associated to ChatTranscript</description>
        <name>Issue_Have_MessagingSession</name>
        <label>Issue Have MessagingSession?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Have_No_ChatTranscript</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>AssociatedMessagingSession</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_MessagingSession_Agent</targetReference>
            </connector>
            <label>Have No ChatTranscript</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>LastModifiedDateToConsider</name>
        <dataType>DateTime</dataType>
        <expression>{!inputIssueRecord.LastModifiedDate}-(1/24)</expression>
    </formulas>
    <interviewLabel>Issue Chat Associate to Messaging {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Issue Chat Associate to Messaging</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_MessagingSession_Agent</name>
        <label>Get MessagingSession Agent</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Have_MessagingSessionToAssociate</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CaseId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>LastModifiedById</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inputIssueRecord.LastModifiedById</elementReference>
            </value>
        </filters>
        <filters>
            <field>LastModifiedDate</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>LastModifiedDateToConsider</elementReference>
            </value>
        </filters>
        <object>MessagingSession</object>
        <outputReference>MessagingSessionToAssociate</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>CaseId</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>GetIssueRecord</name>
        <label>GetIssueRecord</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>GetMessagingSessionRecord</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inputIssueId</elementReference>
            </value>
        </filters>
        <object>Case</object>
        <outputReference>inputIssueRecord</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>LastModifiedDate</queriedFields>
        <queriedFields>LastModifiedById</queriedFields>
        <queriedFields>ContactId</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>GetMessagingSessionRecord</name>
        <label>GetMessagingSessionRecord</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Issue_Have_MessagingSession</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CaseId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inputIssueRecord.Id</elementReference>
            </value>
        </filters>
        <object>MessagingSession</object>
        <outputReference>AssociatedMessagingSession</outputReference>
        <queriedFields>Id</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Link_Contact_to_Messaging_End_User</name>
        <label>Link Contact to Messaging End User</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>AssociatedMessagingSession.MessagingEndUserId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>ContactId</field>
            <value>
                <elementReference>inputIssueRecord.ContactId</elementReference>
            </value>
        </inputAssignments>
        <object>MessagingEndUser</object>
    </recordUpdates>
    <recordUpdates>
        <name>UpdateMessagingSession</name>
        <label>UpdateMessagingSession</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Contact_found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>MessagingSessionToAssociate.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>CaseId</field>
            <value>
                <elementReference>inputIssueRecord.Id</elementReference>
            </value>
        </inputAssignments>
        <object>MessagingSession</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
