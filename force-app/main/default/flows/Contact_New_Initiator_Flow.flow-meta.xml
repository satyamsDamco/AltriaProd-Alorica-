<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Check if the contact is already associated to a Messaging Session</description>
        <name>Contact_Have_MessagingSession</name>
        <label>Contact Have MessagingSession?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Have_No_MessagingSession</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>AssociatedMessagingSession</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_MessagingSession_Agent</targetReference>
            </connector>
            <label>Have No Messaging Session</label>
        </rules>
    </decisions>
    <decisions>
        <name>Have_MessagingSessionToAssociate</name>
        <label>Have MessagingSessionToAssociate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Associate_Messaging</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>MessagingSessionToAssociate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateMessagingEndUser</targetReference>
            </connector>
            <label>Associate Messaging</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>LastModifiedDateToConsider</name>
        <dataType>DateTime</dataType>
        <expression>{!$Record.LastModifiedDate}-(1/24)</expression>
    </formulas>
    <interviewLabel>Contact New - Initiator Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Contact New - Initiator Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_MessagingSession_Agent</name>
        <label>Get MessagingSession Agent</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Have_MessagingSessionToAssociate</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>EndUserContactId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>LastModifiedById</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.LastModifiedById</elementReference>
            </value>
        </filters>
        <filters>
            <field>LastModifiedDate</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>LastModifiedDateToConsider</elementReference>
            </value>
        </filters>
        <filters>
            <field>First_Name__c</field>
            <operator>Contains</operator>
            <value>
                <elementReference>$Record.FirstName</elementReference>
            </value>
        </filters>
        <filters>
            <field>Last_Name__c</field>
            <operator>Contains</operator>
            <value>
                <elementReference>$Record.LastName</elementReference>
            </value>
        </filters>
        <object>MessagingSession</object>
        <outputReference>MessagingSessionToAssociate</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>MessagingEndUserId</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>GetMessagingSessionRecord</name>
        <label>GetMessagingSessionRecord</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Contact_Have_MessagingSession</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>EndUserContactId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <object>MessagingSession</object>
        <outputReference>AssociatedMessagingSession</outputReference>
        <queriedFields>Id</queriedFields>
    </recordLookups>
    <recordUpdates>
        <description>Link the new Contact to the session&apos;s Messaging End User. EndUserContactId on the Messaging Session reflects this automatically.</description>
        <name>UpdateMessagingEndUser</name>
        <label>Link Contact to Messaging End User</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>MessagingSessionToAssociate.MessagingEndUserId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>ContactId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>MessagingEndUser</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetMessagingSessionRecord</targetReference>
        </connector>
        <object>Contact</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>AssociatedMessagingSession</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>MessagingSession</objectType>
    </variables>
    <variables>
        <name>MessagingSessionToAssociate</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>MessagingSession</objectType>
    </variables>
</Flow>
