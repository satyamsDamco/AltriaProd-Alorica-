        /* ── Lookup dropdown helper functions ── */

        /* Show the dropdown list for a given field id */
        function showDropdown(fieldId) {
            var input = document.getElementById(fieldId + 'Text');
            var dropdown = document.getElementById(fieldId);
            if (!dropdown) return;
            /* top/left are handled by CSS (position:absolute; top:100%; left:0)
               inside .lookupWrapper (position:relative) — no inline overrides needed */
            dropdown.style.top = '';
            dropdown.style.left = '';
            filterOptions(fieldId);
            dropdown.style.display = 'block';
        }

        /* Hide the dropdown and sync hidden select value to text input value, then trigger callData */
        function hideDropdown(fieldId, operation) {
            var dropdown = document.getElementById(fieldId);
            if (dropdown) dropdown.style.display = 'none';
            var textInput = document.getElementById(fieldId + 'Text');
            if (textInput && dropdown) {
                var matchFound = false;
                for (var i = 0; i < dropdown.options.length; i++) {
                    if (dropdown.options[i].value.toLowerCase() === textInput.value.toLowerCase()) {
                        dropdown.selectedIndex = i;
                        matchFound = true;
                        break;
                    }
                }
                if (!matchFound) {
                    dropdown.selectedIndex = 0;
                }
            }
            callData(operation, textInput || { id: fieldId + 'Text' });
        }

        var lookupFieldIds = ['brand', 'filter', 'taste', 'length', 'packaging', 'flavor', 'paperType', 'cut'];

        function closeLookupIfClickedOutside(fieldId, evt) {
            var dropdown = document.getElementById(fieldId);
            var textInput = document.getElementById(fieldId + 'Text');
            if (!dropdown || !textInput || dropdown.style.display !== 'block') {
                return;
            }
            var container = textInput.parentNode;
            if (container && container.contains(evt.target)) {
                return;
            }
            var operation = (fieldId === 'brand') ? 4 : 1;
            hideDropdown(fieldId, operation);
        }

        function handleLookupOutsideClick(evt) {
            for (var i = 0; i < lookupFieldIds.length; i++) {
                closeLookupIfClickedOutside(lookupFieldIds[i], evt);
            }
        }

        document.addEventListener('click', handleLookupOutsideClick);

        /* Toggle dropdown visibility */
        function toggleDropdown(fieldId) {
            var dropdown = document.getElementById(fieldId);
            if (!dropdown) return;
            if (dropdown.style.display === 'block') {
                dropdown.style.display = 'none';
            } else {
                filterOptions(fieldId);
                dropdown.style.display = 'block';
            }
        }

        /* Filter visible options based on text input value */
        function filterOptions(fieldId) {
            var input = document.getElementById(fieldId + 'Text');
            var dropdown = document.getElementById(fieldId);
            if (!input || !dropdown) return;
            var filter = input.value.toLowerCase();
            dropdown.style.display = 'block';
            for (var i = 0; i < dropdown.options.length; i++) {
                var opt = dropdown.options[i];
                if (opt.value === '0' || opt.text.toLowerCase().indexOf(filter) !== -1) {
                    opt.style.display = '';
                } else {
                    opt.style.display = 'none';
                }
            }
        }

        /* Handle option click: copy value to text input and trigger callData */
        function selectOption(fieldId, operation) {
            var dropdown = document.getElementById(fieldId);
            var textInput = document.getElementById(fieldId + 'Text');
            if (!dropdown || !textInput) return;
            var selected = dropdown.options[dropdown.selectedIndex];
            if (selected && selected.value !== '0') {
                textInput.value = selected.text;
            } else {
                textInput.value = '';
            }
            dropdown.style.display = 'none';
            callData(operation, dropdown);
        }
        /* ── End lookup dropdown helper functions ── */
    
    </script>

