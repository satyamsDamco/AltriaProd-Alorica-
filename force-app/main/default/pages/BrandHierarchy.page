<apex:page standardController="case" extensions="BrandHierarchyController" id="pg" sidebar="false" showHeader="false" lightningStylesheets="true" standardStylesheets="false">
    <apex:slds />
    <apex:includeScript value="//ajax.googleapis.com/ajax/libs/jquery/1.11.0/jquery.min.js"/>
    <apex:stylesheet value="{!$Resource.AutoCompleteCSSmin}"/><!--using static resource-->
    <apex:stylesheet value="{!$Resource.AutoCompleteThemeCssmin}"/><!--using static resource-->
    <apex:stylesheet value="https://code.jquery.com/ui/1.9.1/themes/base/jquery-ui.css"/>  <!--show Reason list as picklist formate] -->
    
    <apex:includeScript value="{!URLFOR($Resource.Issue_Hierarchy_Resource, 'Issue_hierarchy/jQuerymin.js')}"/>
    <apex:includeScript value="{!URLFOR($Resource.Issue_Hierarchy_Resource, 'Issue_hierarchy/color.js')}"/>   
    <apex:includeScript value="{!URLFOR($Resource.Issue_Hierarchy_Resource, 'Issue_hierarchy/AutoCompleteJQmin.js')}"/>
    
    <apex:includeScript value="https://code.jquery.com/ui/1.11.4/jquery-ui.js" />   
    <script>
         
        window.onload=function () {                       
            $('.labelFilter').hide(); 
            $('.labeltaste').hide();
            $('.labellength').hide();
            $('.labelpackaging').hide();
            $('.labelflavor').hide();
            $('.labelpaperType').hide(); 
            $('.labelcut').hide(); 
            brandListData();
            if('{!brandHierId}' != null && '{!brandHierId}' != '')
                callData(3,'upc');
        }
         
        function brandListData(){
            var prod =  document.getElementById('pg:fm1:pBlock:pageSection:productPblock:product').value;
            var upc = document.getElementById('pg:fm1:pBlock:pageSection:upcPblock:upc').value;
            
            if(upc == null || upc == '' || upc  == '0')
                upc = '0';
            Visualforce.remoting.Manager.invokeAction(
                    '{!$RemoteAction.BrandHierarchyController.productbrandList}',
                    prod,upc,
                    function(result, event){  
                        if (event.status){   
                            $('#brand').find('option').remove();
                            $('#brand').append('<option value="0" selected="selected">--Select--</option>');
                            var brandData = [];
                            for (var a=0;a<result.length; a++){
                               var valuebrand = result[a];
                                if(valuebrand != null && valuebrand.trim()  != ''){
                                    var isExist = !!$('#brand option').filter(function() {
                                        return $(this).attr('value').toLowerCase() === valuebrand.toLowerCase();
                                    }).length;
                                    if (!isExist){
                                        brandData.push(result[a]);
                                        $('<option>').val(result[a]).text(result[a]).appendTo($('#brand'));
                                    }
                                }
                            }
                            if(brandData.length == 1){
                                $('#brandText').val(brandData[0]);
                            }
                            
                            $( "#brandText" ).autocomplete({
                                source: brandData
                            });
                       }
                }, 
                {escape: false}
            );
        
        }
        /* disable filters and UPC when we change Product Line*/
        function disableOnProductLine(){           
            $('.labelFilter').hide(); 
            $('.labeltaste').hide();
            $('.labellength').hide();
            $('.labelpackaging').hide();
            $('.labelflavor').hide();
            $('.labelpaperType').hide();  
            $('.labelcut').hide();
        }
        /* Ends Here */
        /* Enables filters and UPC on once we select the Brand*/
        function enableOnBrand(){ 
            $('.labelUPC').show();
            $('.labelFilter').show(); 
            $('.labeltaste').show();
            $('.labellength').show();
            $('.labelpackaging').show();
            $('.labelflavor').show();
            $('.labelpaperType').show();  
            $('.labelcut').show();
        }
        /*  Ends Here */
        /* If we select the UPC and enter value for UPC then on blur of UPC all filters get disabled */
        function disableOnUPC(){     
            $("#filter").prop("disabled", true);
            $("#taste").prop("disabled", true);
            $("#length").prop("disabled", true);
            $("#packaging").prop("disabled", true);
            $("#flavor").prop("disabled", true);
            $("#paperType").prop("disabled", true);
            $("#cut").prop("disabled", true);                 
        }
        /* Ends Here */
        /* if we select values from filter then UPC field will b disabled*/
        function disableUPC(){                 
            document.getElementById('pg:fm1:pBlock:pageSection:upcPblock:upc').disabled = true;
        }
        /* Ends Here */
        function enableFields(){
            $("#filter").prop("disabled", false);
            $("#taste").prop("disabled", false);
            $("#length").prop("disabled", false);
            $("#packaging").prop("disabled", false);
            $("#flavor").prop("disabled", false);
            $("#paperType").prop("disabled", false);
            $("#cut").prop("disabled", false); 
            document.getElementById('pg:fm1:pBlock:pageSection:upcPblock:upc').disabled = false;
            document.getElementById('pg:fm1:pBlock:pageSection:upcPblock:upc').value = '';
        }
        /* Ends Here */
        function callAction(e)
        {          
            fillBrandHier(e);   
            callData(2,this);     
        }
        function callData(operation,tagId)
        {   
            var upc = 0;
            var brand = 0;
            var filter = 0;
            var taste =  0;
            var length =  0;
            var packaging =  0;
            var flavor =  0;
            var paperType =  0;
            var cut = 0;
            var ids = 0;
            var prod =  document.getElementById('pg:fm1:pBlock:pageSection:productPblock:product').value;
            brand = document.getElementById('brandText').value; // document.getElementById('pg:fm1:pBlock:pageSection:brandPblock:brand').value;
            
            if( operation == 1){
                 
                filter =  document.getElementById('filterText').value;
                taste = document.getElementById('tasteText').value;
                length = document.getElementById('lengthText').value;
                packaging =  document.getElementById('packagingText').value;
                flavor =  document.getElementById('flavorText').value;
                paperType =  document.getElementById('paperTypeText').value;
                cut =  document.getElementById('cutText').value;
                var exists = false; 
                if(tagId.id=='filter' || tagId.id=='filterText'){
                    
                    $('#filter  option').each(function(){
                      if (this.value == filter) {
                        exists = true;
                      }
                    });
                    if(!exists && filter.length >0){
                        alert('Select or enter valid filter');
                    }
                    if(filter.length <=0){
                        document.getElementById("filter").selectedIndex = "0";
                        document.getElementById("pg:fm1:pBlock:pageSection:brandHierId").value = '';
                    }
                }
                
                if(tagId.id=='taste' || tagId.id=='tasteText'){
                    $('#taste option').each(function(){
                      if (this.value == taste) {
                        exists = true;
                      }
                    });
                    if(!exists && taste.length >0){
                        alert('Select or enter valid taste');
                    }
                    if(taste.length <=0){
                        document.getElementById("taste").selectedIndex = "0";
                        document.getElementById("pg:fm1:pBlock:pageSection:brandHierId").value = '';
                    }
                }
                
                if(tagId.id=='length' || tagId.id=='lengthText'){
                    $('#length option').each(function(){
                      if (this.value == length) {
                        exists = true;
                      }
                    });
                    if(!exists && length.length >0){
                        alert('Select or enter valid length');
                    }
                    if(length.length <=0){
                        document.getElementById("length").selectedIndex = "0";
                        document.getElementById("pg:fm1:pBlock:pageSection:brandHierId").value = '';
                    }
                }
                
                if(tagId.id=='packaging' || tagId.id=='packagingText'){
                    $('#packaging option').each(function(){
                      if (this.value == packaging) {
                        exists = true;
                      }
                    });
                    if(!exists && packaging.length >0){
                        alert('Select or enter valid packaging');
                    }
                    if(packaging.length <=0){
                        document.getElementById("packaging").selectedIndex = "0";
                        document.getElementById("pg:fm1:pBlock:pageSection:brandHierId").value = '';
                    }
                }
                
                if(tagId.id=='flavor' || tagId.id=='flavorText'){
                    $('#flavor option').each(function(){
                      if (this.value == flavor) {
                        exists = true;
                      }
                    });
                    if(!exists && flavor.length >0){
                        alert('Select or enter valid flavor');
                    }
                    if(flavor.length <=0){
                        document.getElementById("flavor").selectedIndex = "0";
                        document.getElementById("pg:fm1:pBlock:pageSection:brandHierId").value = '';
                    }
                }
                
                if(tagId.id=='paperType' || tagId.id=='paperTypeText'){
                    $('#paperType option').each(function(){
                      if (this.value == paperType) {
                        exists = true;
                      }
                    });
                    if(!exists && paperType.length >0){
                        alert('Select or enter valid Paper Type');
                    }
                    if(paperType.length <=0){
                        document.getElementById("paperType").selectedIndex = "0";
                        document.getElementById("pg:fm1:pBlock:pageSection:brandHierId").value = '';
                    }
                }
                
                if(tagId.id=='cut' || tagId.id=='cutText'){
                    $('#cut option').each(function(){
                      if (this.value == cut) {
                        exists = true;
                      }
                    });
                    if(!exists && cut.length >0){
                        alert('Select or enter valid cut');
                    }
                    
                    if(cut.length <=0){
                        document.getElementById("cut").selectedIndex = "0";
                        document.getElementById("pg:fm1:pBlock:pageSection:brandHierId").value = '';
                    }
                }
                if(!exists){
                    return false;
                }
                
                if(exists == true) {
                
                    enableFields();
                    enableOnBrand();
                    if(tagId.id=='filter' || tagId.id=='filterText' || tagId.id=='taste' || tagId.id=='tasteText' || tagId.id=='length' || tagId.id=='lengthText' || tagId.id=='packaging' || tagId.id=='packagingText' || tagId.id=='flavor' || tagId.id=='flavorText' || tagId.id=='paperType' || tagId.id=='paperTypeText' || tagId.id == 'cut' || tagId.id == 'cutText'){
                        disableUPC();
                    }
                    upc = 0;
                    
                    if(filter == null || filter == '')
                        filter = '0';
                   
                    if(taste == null || taste == '')
                        taste = '0';
                   
                    if(length == null || length == '')
                        length = '0';
                    
                    if(packaging == null || packaging == '')
                        packaging = '0';
                    
                    if(flavor == null || flavor == '')
                        flavor = '0';
                    
                    if(paperType == null || paperType == '')
                        paperType = '0';
                    
                    if(cut == null || cut == '')
                        cut = '0';
                }
            }else if( operation == 4){
                 
                var exists = false; 
                resetBrand();
                $('#brand  option').each(function(){
                  if (this.value == brand) {
                    exists = true;
                  }
                });
                if(!exists && brand.length >0){
                    alert('Select or enter valid brand');
                }
                
                if(brand.length <= 0){
                    
                    document.getElementById("brand").selectedIndex = "0";
                    document.getElementById("pg:fm1:pBlock:pageSection:brandHierId").value = '';
                    $('.labelFilter').hide(); 
                    $('.labeltaste').hide();
                    $('.labellength').hide();
                    $('.labelpackaging').hide();
                    $('.labelflavor').hide();
                    $('.labelpaperType').hide(); 
                    $('.labelcut').hide(); 
                    document.getElementById('pg:fm1:pBlock:pageSection:upcPblock:upc').value = '';
                    return false;
                }else{
                    disableUPC();
                    enableFields();
                    enableOnBrand();
                    
                    upc = 0;
                    filter = 0;
                    taste =  0;
                    length =  0;
                    packaging =  0;
                    flavor =  0;
                    paperType =  0;
                    cut = 0;
                    $('#filterText').val('');
                    $('#tasteText').val('');
                    $('#lengthText').val('');
                    $('#packagingText').val('');
                    $('#tasteText').val('');
                    $('#flavorText').val('');
                    $('#paperTypeText').val('');
                    $('#cutText').val(''); 
                }
                
            }else if( operation == 0){
               
                upc = 0;
                brand = 0;
                filter = 0;
                taste =  0;
                length =  0;
                packaging =  0;
                flavor =  0;
                paperType =  0;
                cut = 0;
                document.getElementById('pg:fm1:pBlock:pageSection:upcPblock:upc').value = '';
                 document.getElementById("brandText").value = '';
                 document.getElementById("brand").selectedIndex = "0"; 
                //document.getElementById('pg:fm1:pBlock:pageSection:brandPblock:brand').selectedIndex = "0"; 
                $('#brandText').val('');
                $('#filterText').val('');
                $('#tasteText').val('');
                $('#lengthText').val('');
                $('#packagingText').val('');
                $('#tasteText').val('');
                $('#flavorText').val('');
                $('#paperTypeText').val('');
                $('#cutText').val('');  
                brandListData();        
            }else if ( operation == 2){
               
                upc = document.getElementById('pg:fm1:pBlock:pageSection:upcPblock:upc').value;
                filter =  0;
                taste =  0;
                length =  0;
                packaging =  0;
                flavor =  0;
                paperType =  0;
                cut = 0;
                brand = 0;
                brandListData();
            }else if ( operation == 3){
               
                upc = 0;
                filter =  0;
                taste =  0;
                length =  0;
                packaging =  0;
                flavor =  0;
                paperType =  0;
                brand =  0;
                cut = 0;
                ids ='{!brandHierId}';
            }
            if(operation != 0){                
                /* Population of Filter values */
                Visualforce.remoting.Manager.invokeAction(
                    '{!$RemoteAction.BrandHierarchyController.brandHierDataList}',
                    ids,prod,brand,filter,taste,length,packaging,flavor,paperType,upc,cut,'alldata',
                    function(result, event){                    
                        if (event.status){            
                            $('#filter').find('option').remove();
                            $('#taste').find('option').remove();
                            $('#length').find('option').remove();
                            $('#packaging').find('option').remove();
                            $('#taste').find('option').remove();
                            $('#flavor').find('option').remove();
                            $('#paperType').find('option').remove();
                            $('#cut').find('option').remove();
                            
                            $('#filter').append('<option value="0" selected="selected">--Select--</option>');
                            $('#taste').append('<option value="0" selected="selected">--Select--</option>');
                            $('#length').append('<option value="0" selected="selected">--Select--</option>');
                            $('#packaging').append('<option value="0" selected="selected">--Select--</option>');
                            $('#flavor').append('<option value="0" selected="selected">--Select--</option>');
                            $('#paperType').append('<option value="0" selected="selected">--Select--</option>');
                            $('#cut').append('<option value="0" selected="selected">--Select--</option>');     
                            var UPCList = [];
                            var filterData = [], tasteData = [], lengthData = [], packagingData = [], flavorData = [], paperTypeData = [], cutData = [];
                            //alert(result.length);
                            for (var a=0;a<result.length; a++){
                                if(result.length == 1){                       
                                    document.getElementById( 'pg:fm1:pBlock:pageSection:brandHierId').value = result[a].Id;
                                    document.getElementById('brandText').value = result[a].Brand_Code__r.Name;
                                    document.getElementById('brand').value = result[a].Brand_Code__r.Name;
                                }
                                var hierarchyId = [];
                                if(result[a].UPC__c != null && result[a].UPC__c.trim() != '' && UPCList.indexOf(result[a].UPC__c) != 0){
                                    UPCList.push(result[a].UPC__c);                        
                                }
                                var valueFilter = result[a].Filter__c;
                                if(valueFilter  != null && valueFilter.trim()  != ''){
                                    var isExist = !!$('#filter option').filter(function() {
                                        return $(this).attr('value').toLowerCase() === valueFilter.toLowerCase();
                                    }).length;
                                    if (!isExist){
                                        filterData.push(result[a].Filter__c);
                                        $('<option>').val(result[a].Filter__c).text(result[a].Filter__c).appendTo($('#filter'));
                                    }
                                }
                                var valueTaste = result[a].Taste__c;
                                if(valueTaste  != null && valueTaste.trim()  != ''){
                                    var isExistTaste = !!$('#taste option').filter(function() {
                                        return $(this).attr('value').toLowerCase() === valueTaste.toLowerCase();
                                        }).length;
                                        if (!isExistTaste){
                                            tasteData.push(result[a].Taste__c);
                                            $('<option>').val(result[a].Taste__c).text(result[a].Taste__c).appendTo($('#taste'));
                                        }
                                    }
                                    var valueLength = result[a].Length__c;
                                    if(valueLength != null && valueLength.trim() != ''){
                                        var isExistLength = !!$('#length option').filter(function() {
                                            return $(this).attr('value').toLowerCase() === valueLength.toLowerCase();
                                        }).length;
                                        
                                        if (!isExistLength ) {
                                            lengthData.push(result[a].Length__c);
                                            $('<option>').val(result[a].Length__c).text(result[a].Length__c).appendTo($('#length'));
                                        }
                                     }
                                    var valuePackaging = result[a].Packaging__c;
                                    if(valuePackaging != null && valuePackaging.trim() != ''){
                                       var  isExistPackaging = !!$('#packaging option').filter(function() {
                                            return $(this).attr('value').toLowerCase() === valuePackaging.toLowerCase();
                                        }).length;
                                        
                                         if (!isExistPackaging ) {
                                            packagingData.push(result[a].Packaging__c);
                                            $('<option>').val(result[a].Packaging__c).text(result[a].Packaging__c).appendTo($('#packaging'));
                                        }  
                                    }  
                                    var valueFlavor = result[a].Flavor__c;
                                    if(valueFlavor != null && valueFlavor.trim() != ''){
                                        var isExistFlavor = !!$('#flavor option').filter(function() {
                                            return $(this).attr('value').toLowerCase() === valueFlavor.toLowerCase();
                                            }).length;
                                         if (!isExistFlavor) {
                                             flavorData.push(result[a].Flavor__c);
                                            $('<option>').val(result[a].Flavor__c).text(result[a].Flavor__c).appendTo($('#flavor'));
                                        }
                                    }
                                    
                                    var valuePaperType = result[a].PaperType__c;
                                    if(valuePaperType != null && valuePaperType.trim() != ''){
                                        var isExistPaperType = !!$('#paperType option').filter(function() {
                                            return $(this).attr('value').toLowerCase() === valuePaperType.toLowerCase();
                                            }).length;
                                        
                                        if (!isExistPaperType ) {
                                             paperTypeData.push(result[a].PaperType__c);
                                            $('<option>').val(result[a].PaperType__c).text(result[a].PaperType__c).appendTo($('#paperType'));
                                        }
                                    }
                                    var valueCut = result[a].Cut__c;
                                    if(valueCut != null && valueCut.trim() != ''){
                                    var isExistCut = !!$('#cut option').filter(function() {
                                        return $(this).attr('value').toLowerCase() === valueCut.toLowerCase();
                                        }).length;
                            
                                    if(!isExistCut ) {
                                        cutData.push(result[a].Cut__c);
                                        $('<option>').val(result[a].Cut__c).text(result[a].Cut__c).appendTo($('#cut'));
                                    }
                                }
                                if(filter != null && filter != '' && filter != 'null'){  
                                    $('#filter').val(filter);
                                    if(filter !=  '0')
                                        $('#filterText').val(filter);
                                }
                                    
                                if(taste != null && taste != '' && taste != 'null'){ 
                                    $('#taste').val(taste);
                                    if(taste !=  '0')
                                        $('#tasteText').val(taste);
                                }
                                    
                                if(length != null && length != '' && length != 'null'){  
                                    $('#length').val(length);
                                    if(length !=  '0')
                                        $('#lengthText').val(length);
                                }
                                    
                                if(packaging != null && packaging != '' && packaging != 'null'){ 
                                   $('#packaging').val(packaging);
                                   if(packaging !=  '0')
                                        $('#packagingText').val(packaging);
                                }
                                    
                                if(flavor != null && flavor != '' && flavor != 'null'){  
                                    $('#flavor').val(flavor);
                                    if(flavor !=  '0')
                                        $('#flavorText').val(flavor);
                                }
                                    
                                if(paperType != null && paperType != '' && paperType != 'null'){ 
                                   $('#paperType').val(paperType);
                                   if(paperType !=  '0')
                                        $('#paperTypeText').val(paperType);
                                }
                                
                                if(cut != null && cut != '' && cut != 'null'){ 
                                   $('#cut').val(cut);
                                   if(cut !=  '0')
                                        $('#cutText').val(cut);
                                }   
                            }
                            
                            
                            
                            if(filterData.length == 1){
                                $('#filterText').val(filterData[0]);
                            }
                            
                            $( "#filterText" ).autocomplete({
                                source: filterData 
                            });
                            
                            if(tasteData .length == 1){
                                $('#tasteText').val(tasteData [0]);
                            }
                            
                            $( "#tasteText" ).autocomplete({
                                source: tasteData 
                            }); 
                            
                            if(lengthData.length == 1){
                                $('#lengthText').val(lengthData[0]);
                            }                           
                            
                            $( "#lengthText" ).autocomplete({
                                source: lengthData
                            });
                            
                            if(packagingData.length == 1){
                                $('#packagingText').val(packagingData[0]);
                            }
                            
                            $( "#packagingText" ).autocomplete({
                                source: packagingData
                            });
                            
                            if(flavorData.length == 1){
                                $('#flavorText').val(flavorData[0]);
                            }
                           
                            $( "#flavorText" ).autocomplete({
                                source: flavorData
                            });
                            
                            if(paperTypeData.length == 1){
                                $('#paperTypeText').val(paperTypeData[0]);
                            }
                            
                            $( "#paperTypeText" ).autocomplete({
                                source: paperTypeData
                            });
                            
                            if(cutData.length == 1){
                                $('#cutText').val(cutData[0]);
                            }
                            
                            $( "#cutText" ).autocomplete({
                                source: cutData
                            }); 
                                                        
                            /* Population of filters ends here*/
                            /* displaying the default filter values when there is only one values in the filter */   
                            if(document.getElementById("filter").options.length == 2)
                                document.getElementById("filter").selectedIndex = "1";                 
                                   
                            if(document.getElementById("taste").options.length == 2)
                                document.getElementById("taste").selectedIndex = "1";
                                        
                            if(document.getElementById("length").options.length == 2)
                                document.getElementById("length").selectedIndex = "1";
                                        
                            if(document.getElementById("packaging").options.length == 2)
                                document.getElementById("packaging").selectedIndex = "1";
                                        
                            if(document.getElementById("flavor").options.length == 2)
                                 document.getElementById("flavor").selectedIndex = "1";
                                        
                            if(document.getElementById("paperType").options.length == 2)
                                document.getElementById("paperType").selectedIndex = "1";
                            
                            if(document.getElementById("cut").options.length == 2)
                               document.getElementById("cut").selectedIndex = "1";
                               
                            
                           
                            if(result.length == 2){
                                for (var a=0;a<result.length; a++){ 
                                    if(((document.getElementById("filter").options.length == 2 &&  document.getElementById("filter").selectedIndex == "1" && document.getElementById('filter').value == result[a].Filter__c)
                                    ||  document.getElementById("filter").options.length == 1)
                                    && ( (document.getElementById("taste").options.length == 2 && document.getElementById("taste").selectedIndex == "1" && document.getElementById('taste').value == result[a].Taste__c)
                                    || document.getElementById("taste").options.length == 1)
                                    && ((document.getElementById("length").options.length == 2 && document.getElementById("length").selectedIndex == "1" && document.getElementById('length').value == result[a].Length__c)
                                    || document.getElementById("length").options.length == 1)
                                    && ((document.getElementById("packaging").options.length == 2 && document.getElementById("packaging").selectedIndex == "1" && document.getElementById('packaging').value == result[a].Packaging__c)
                                    || document.getElementById("packaging").options.length == 1)
                                    && ((document.getElementById("flavor").options.length == 2  && document.getElementById("flavor").selectedIndex == "1" && document.getElementById('flavor').value == result[a].Flavor__c)
                                    || document.getElementById("flavor").options.length == 1)
                                    && ((document.getElementById("paperType").options.length == 2 && document.getElementById("paperType").selectedIndex == "1" && document.getElementById('paperType').value == result[a].PaperType__c)
                                    || document.getElementById("paperType").options.length == 1)
                                    && ((document.getElementById("cut").options.length == 2 && document.getElementById("cut").selectedIndex == "1" && document.getElementById('cut').value == result[a].Cut__c)
                                    || document.getElementById("cut").options.length == 1)                                     
                                    ){                                             
                                        document.getElementById( 'pg:fm1:pBlock:pageSection:brandHierId').value = result[a].Id;
                                        document.getElementById('brandText').value = result[a].Brand_Code__r.Name;
                                        document.getElementById('brand').value = result[a].Brand_Code__r.Name; 
                                    }                                  
                                }                            
                            }
                               
                            
                            if((document.getElementById("filter").options.length == 2 ||  document.getElementById("filter").options.length == 1)
