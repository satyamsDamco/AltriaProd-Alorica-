                               onfocus="showDropdown('cut')"
                               onkeyup="filterOptions('cut')"
                               class="slds-input lookupInput"/>
                        <button type="button" onclick="toggleDropdown('cut')" class="lookupBtn">&#9660;</button>
                        <select id="cut" size="5"
                                onclick="selectOption('cut',1)"
                                onchange="document.getElementById('cutText').value=this.options[this.selectedIndex].text;callData(1,this);"
                                class="lookupDropdown"></select>
                        <input type="hidden" id="cutValue"/>
                    </div>
                </apex:pageBlockSectionItem>
                <apex:inputHidden id="brandHierId" value="{!brandHierid}"/>
            </apex:pageBlockSection>

            <apex:pageBlockSection columns="1">
                <apex:pageBlockSectionItem >
                    <div class="slds-text-align_center" style="width: 74%;float: right;">
                        <button class="slds-button slds-button_neutral" onclick="resetData(); return false;">Reset</button>
                        <button class="slds-button slds-button_brand" onclick="submitData(); return false;">Submit</button>
                        <button class="slds-button  slds-button_neutral" onclick="closePopup(); return false;">Close</button>
                    </div>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>

            <!-- Seach Form for brand Hierarchy Ends Here -->
            <!-- The below code is used for displaying records returned from the search made on UPC or filters -->
           <!-- <apex:outputPanel id="outPanelBH"> -->
            <!-- added by Pratiksha -->
             <apex:outputPanel id="outPanelBH" layout="block" style="clear:both;width:100%;">
                <apex:pageBlock id="pBlockBH" mode="edit" rendered="{!If(brandHierarchyList.size >0,true,false)}">
                    <apex:pageBlockTable id="pBlockTableBH" value="{!brandHierarchyList}" var="b" rendered="{!showTable}"  >
                        <apex:column >
                            <input type="radio" name="chosen" id="{!b.id}" VALUE="{!b.id}" onclick="getBrandHierId(this.id,'{!b.Brand_Code__r.Name}','{!b.Filter__c}','{!b.Taste__c}','{!b.Length__c}','{!b.Packaging__c}','{!b.Flavor__c}','{!b.PaperType__c}','{!b.Cut__c}' );"/>
                        </apex:column>    
                        <apex:column value="{!b.Brand_Code__r.Name}"/>
                        <apex:column value="{!b.Filter__c}" />
                        <apex:column value="{!b.Taste__c}" />
                        <apex:column value="{!b.Length__c}" />
                        <apex:column value="{!b.Packaging__c}" />
                        <apex:column value="{!b.Flavor__c}" />
                        <apex:column value="{!b.PaperType__c}" />
                        <apex:column value="{!b.Cut__c}" />
                    </apex:pageBlockTable>
                </apex:pageBlock>
            </apex:outputPanel>
        </apex:pageBlock>
        <!-- Page Block Table Ends here -->
    </apex:form>

   
</apex:page>