<apex:page standardController="Hot_Zip__c" extensions="HotZipController" lightningStyleSheets="true">
    <apex:slds />
    
    
    <apex:includeScript value="/support/console/62.0/integration.js"/>
    
    
    
    <script>
    
    
    function CloseTab() {
        sforce.console.getEnclosingTabId(function(result) {
            console.log('Tab Result:', result);
            
            if(result.success && result.id) {
                sforce.console.closeTab(result.id);
            } else {
                console.error(result);
            }
        });
        
        return false;
    }
    
    
    </script>
    <apex:form >    
        <apex:pageBlock title="Hot Zips">
            <div class="slds-grid slds-grid_align-center slds-m-vertical_medium">
                <apex:commandButton value="Close"
                                    onclick="CloseTab();return false;"
                                    styleClass="slds-button slds-button_neutral"/>
            </div>
            <apex:pageBlockSection >
                <apex:outputField value="{!hz.Zip_Code_Documentation__c}" label="" />
            </apex:pageBlockSection>
            <apex:pageBlockSection title="Consumer Information">
                <apex:outputText value="{!conObj.FirstName}" />
                <apex:outputText value="{!conObj.LastName}" />
                <apex:outputText value="{!conObj.Street_Address__c}" />
                <apex:outputText value="{!conObj.Apt_Lot__c}" />
                <apex:outputText value="{!conObj.Zip_Code__c}" />
                <apex:outputText value="{!conObj.State__c}" />
                <apex:outputText value="{!conObj.Phone}" label="Telephone" />
                <apex:outputText value="{!conObj.OtherPhone}" label="Alternate Telephone" />
            </apex:pageBlockSection>
        </apex:pageBlock>
        <div class="slds-grid slds-grid_align-center slds-m-vertical_medium">
            <apex:commandButton value="Close"
                                onclick="CloseTab();return false;"
                                styleClass="slds-button slds-button_neutral"/>
        </div>
    </apex:form>
</apex:page>