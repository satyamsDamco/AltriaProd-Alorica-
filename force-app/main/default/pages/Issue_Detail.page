            function openPrimaryTabEndCall(){             

                // Get values from Apex
                var custId = '{!custId}';
                var isSurveyApplicable = '{!isSurveyApplicable}';
                var customerRecType = '{!customerRecType}';

                // Normalize values (important fix)
                if(custId === 'null' || custId === undefined){
                    custId = '';
                }

                // Case 1: Survey Required
                if(isSurveyApplicable === 'Required'){

                    if(!custId){
                        if(customerRecType === 'consumer'){
                            alert('Please present the survey or select a Cancel Reason \nPlease select the Consumer for which the issue is created');
                        }else{
                            alert('Please present the survey or select a Cancel Reason \nPlease select the Trade Customer for which the issue is created');
                        }
                    }else{
                        alert('Please present the survey or select a Cancel Reason');
                    }
                    return; // stop execution
                }

                // Case 2: Survey NOT Required → check customer
                if(!custId){
                    if(customerRecType === 'consumer'){
                        alert('Please select the consumer for which the issue is created');
                    }else{
                        alert('Please select the trade customer for which the issue is created');
                    }
                    return; // stop execution
                        }
                        // Lightning Navigation
                        if (typeof sforce !== 'undefined' && sforce.one) {
                            sforce.one.navigateToURL(
                                '/apex/EndCall?retURL=' +
                                encodeURIComponent('{!JSENCODE($CurrentPage.parameters.retURL)}')
                            );
                        }
                        // Classic Navigation
                        else {
                            window.location.href =
                                '/apex/EndCall?retURL=' +
                                encodeURIComponent('{!JSENCODE($CurrentPage.parameters.retURL)}');
                        }
                    }
                
            function openConsumer(eve) {

                var customerId = '{!case.ContactId}';
                var customerRecType = "{!customerRecType}";
                var parameters = "{!parameters}";

                //  If no customer → go to Search page
                if (!customerId || customerId == 'null' || eve != 'Contact') {

                    var searchUrl;

                    if (customerRecType == 'consumer') {
                        searchUrl = '/apex/ConsumerSearch?hideIssue=true' + (parameters || '');
                    } else {
                        searchUrl = '/apex/TradeSearch?hideIssue=true' + (parameters || '');
                    }

                    if (typeof sforce !== 'undefined' && sforce.one) {
                        sforce.one.navigateToURL(searchUrl);
                    } else {
                        window.location.href = searchUrl;
                    }
                    return;
                }
                
                var detailUrl = '';
                if (customerRecType === 'consumer') {
                    detailUrl = '/apex/ConsumerDetailPage?id=' + customerId;
                } else {
                    detailUrl = '/apex/ConsumerDetailPage?id=' + customerId;
                }

                if (typeof sforce !== 'undefined' && sforce.one) {
                    sforce.one.navigateToURL(detailUrl);
                } else {
                    window.location.href = detailUrl;
                }
            }

            function refreshCurrentPage() {
                window.location.reload(true);
            }

            function refreshCurrentTab() {
                // In Lightning we don't have tabId, so we simulate behavior
                if (subTabIssue == '' || subTabIssue == null) {
                    subTabIssue = '';
                    ConsumerDetail();

                    // Refresh UI (Lightning)
                    if (typeof sforce !== 'undefined' && sforce.one) {
                        sforce.one.refreshView();
                    } else {
                        location.reload();
                    }
                }
            } 
            
            
            var openSuccess = function openSuccess(result) {
                //Report whether we succeeded in opening the subtab
                if (result.success == true) {
                    //alert('subtab successfully opened');
                } else {
                    //alert('subtab cannot be opened');
                }
            };
        
            var onFocusedSubtabCallback = function (result) {
                var entityId = result.objectId; 
                subTabIssue = result.id;
                // Safe null check - prevents crash when refresh button not found
                var refreshBtn = document.getElementById("{!$Component.frm:pb:pbButton:refresh}");
                if (refreshBtn) {
                    refreshBtn.click();
                }
            };  

            try {
                if (typeof sforce !== 'undefined' && sforce.console) {
                    sforce.console.onFocusedSubtab(onFocusedSubtabCallback);
                }
            } catch(e) {
                console.warn('Console API not available: ', e.message);
            }
            
            function OpenSubtabSurvey() {

