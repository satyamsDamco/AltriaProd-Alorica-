        function opencloneSubtab() {
                var issueid = '{!$CurrentPage.parameters.id}';
                var issueNumber = '{!caseObj.CaseNumber__c}';
                var parameters = "{!parameters}";

            //  var retURL = '{!JSENCODE($CurrentPage.parameters.retURL)}';
                var retURL = window.location.href;
    
                sforce.one.navigateToURL( '/apex/IssueEntryClone?id=' + issueid + '&parentIssue=' + issueid + '&retURL=' + encodeURIComponent(retURL) + parameters);

            }
            function editIssue() {

                var issueId = '{!issueIds}';

                var url = '/apex/IssueEntryPage?id=' + issueId;

                if (typeof sforce !== 'undefined' && sforce.one) {
                    sforce.one.navigateToURL(url);
                } else {
                    window.open(detailUrl, '_self');
                }
            }

            function confirmsend()
                {
                    

                    return confirm('Online Verification Form is about to be sent to the Consumer to verify their age. Do you want to proceed?');
                }
                
            function deleteRecord(recordId, objectApiName) {
                if(confirm('Are you sure you want to delete this record?')) {
                    var sessionId = '{!$Api.Session_ID}';
                    var xhr = new XMLHttpRequest();
                    xhr.open('DELETE', '/services/data/v39.0/sobjects/' + objectApiName + '/' + recordId, true);
                    xhr.setRequestHeader('Authorization', 'Bearer ' + sessionId);
                    xhr.setRequestHeader('Content-Type', 'application/json');
                    xhr.onreadystatechange = function() {
                        if(xhr.readyState == 4) {
                            if(xhr.status == 204) {
                                //alert('Record deleted successfully.');
                                location.reload();
                            } else {
                                alert('Delete failed. Status: ' + xhr.status + ' - ' + xhr.responseText);
                            }
                        }
                    };
                    xhr.send();
            }
            }
