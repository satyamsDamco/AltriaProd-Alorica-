        <script>
            function surveyApplicable(){
                var isSurveyApplicable = '{!isSurveyApplicable}';
                var tranCurrent = "{!currentTran}";
                if(isSurveyApplicable == 'Required' && tranCurrent != null && tranCurrent != ''){
                    if("{!customerRecType}" == 'consumer'){
                        alert('Consumer eligible for survey');
                    }else{
                        alert('Trade Customer eligible for survey');
                    }
                }
            }
            
            // lifetime of the page (i.e., until this specific tab is reloaded)
            var CURRENT_TAB_ID = null;
            var pageLoad = window.onload;

            // 2. Reference the standard Lightning Console Tab Focused message channel
            // Note: The channel name requires the "__c" suffix when imported in Visualforce
            var tabFocusedChannel = "{!$MessageChannel.lightning__tabFocused}";
            var subscription;
            
            window.onload = function() {
                if (pageLoad) {
                    pageLoad();
                }
                surveyApplicable();

                if (sforce && sforce.one) {
                    subscription = sforce.one.subscribe(tabFocusedChannel, handleTabClick, { scope: "APPLICATION" });
                    console.log("Subscribed to tab focus events.");
                }

                sforce.console.getEnclosingPrimaryTabId(function(result) {
                    if (result.success) {
                        //console.log("CURRENT_TAB_ID:" + result.id);
                        CURRENT_TAB_ID = result.id;
                        console.log("CURRENT_TAB_ID:" + CURRENT_TAB_ID);
                    }
                });
            }

            // 4. Handle the event when a tab is clicked/focused
            function handleTabClick(message) {
                if (message) {
                    var currentTabId = message.currentTabId;
                    var previousTabId = message.previousTabId;
                    if(CURRENT_TAB_ID==currentTabId){
                        window.location.reload(true);
                    }
                    
                    console.log("Tab Clicked! Current Tab ID: " + currentTabId);
                    console.log("Previous Tab ID: " + previousTabId);
                    console.log("CURRENT_TAB_ID:" + CURRENT_TAB_ID);
                    
                    // Place your custom logic here (e.g., refreshing data, tracking user action)
                }
            }

            // 5. Clean up the subscription if the page unloads
            window.onunload = function() {
                if (subscription) {
                    sforce.one.unsubscribe(subscription);
                }
            };
            
            function reimbursement(){
                if('{!custId}' == null || '{!custId}' == ''){
                    alert('Please create Consumer record before Reimbursement.');    
                }else if('{!customertype}' != 'CONSUMER'){
                    alert('Cannot create reimbursement for Non-Consumer type Customer.');
                }else if('{!country}' != 'United States'){
                    alert('Cannot create reimbursement for International Consumer.');
                }else if('{!case.Issue_Type__c}' != null && '{!case.Issue_Type__c}' != 'Complaints'){
                    alert('Reimbursements only allowed for complaint issues');
                }else if('{!isReimbursed}' == 'true'){
                    alert('Reimbursement already created');
                }else{
                    var issueId= '{!$CurrentPage.parameters.id}';
                    var url = '/apex/ReimbursementEdit?issueId=' + issueId;

                if (typeof sforce !== 'undefined' && sforce.one) {
                    sforce.one.navigateToURL(url);
                } else {
                    window.location.href = url;
                }
                }
            }
            
            var openSubtabReimb = function openSubtabReimbursement(result) {
                var primaryTabId = result.id;            
                var issueId= '{!$CurrentPage.parameters.id}';           
                sforce.console.openSubtab(primaryTabId ,'/apex/ReimbursementEdit?issueId='+issueId, true, 'Reimbursement',null,  openSuccess, 'Reimbursement'+issueId);
            };

            function openSurvey() {

                var issueId = '{!$CurrentPage.parameters.id}';  //  Correct ID source
                if (!issueId) {
                    alert('Issue Id not found');
                    return;
                }
                var surveyUrl = '/apex/IssueSurvey?issueId=' + issueId;
                // Lightning Experience
                if (typeof sforce !== 'undefined' && sforce.one) {
                    sforce.one.navigateToURL(surveyUrl);
                // Classic Console - open as subtab
                } else if (typeof sforce !== 'undefined' && sforce.console && sforce.console.isInConsole()) {
                    sforce.console.getEnclosingPrimaryTabId(function(result) {
                    sforce.console.openSubtab(result.id, surveyUrl, true, 'Survey', null, openSuccess, 'Survey' + issueId);
                });
                // Fallback
                } else {
                    window.location.href = surveyUrl;
                }
            }
            
            
