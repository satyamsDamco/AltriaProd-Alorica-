                <apex:outputField value="{!case.PurchaseQty__c}" label="Purchase Quantity" />
                <apex:outputField value="{!case.Returned_Type__c}" label="Returned Type" id="returnedType"/>
                <apex:outputText value=" " label=" " />
                <apex:outputField value="{!case.Returned_Quantity__c}" label="Returned Quantity" id="returnedQty"/>
            </apex:pageBlockSection>
            
            <apex:pageBlockSection title="Issue Information " collapsible="TRUE" id="IssDetail" >
                <apex:outputField value="{!case.Trace_Code_Location__c}" label="Trace Code Location"/>
                <apex:outputField value="{!case.Suspected_Counterfiet__c}" label="Suspected Counterfeit"/>
                <apex:outputField value="{!case.Mfg_Trace_code__c}" label="Mfg/Trace code"/>
                <apex:outputtext rendered="{!iqosTrue}" />
                <apex:outputField value="{!case.TC_Serial_Number__c}" label="TC Serial Number" rendered="{!iqosTrue}"/> 
                <apex:outputField value="{!case.Suspected_Tampering__c}" label="Suspected Tampering"/> 
                
                <apex:outputText value="{0,date,MM/dd/yyyy}" label="Production Date"> 
                    <apex:param value="{!case.Production_date__c}" /> 
                </apex:outputText>  
                
                <apex:outputField value="{!case.Test_Issue__c}" label="Test Issue"/> 
                
                <!-- <apex:pageBlockSectionItem id="section1" rendered="{!IF(NOT(case.Product_Line__c=='Cigars' || case.Product_Line__c=='Green Smoke E-Vapor' 
                                                                   || case.Product_Line__c=='E-Cigarette' || case.Product_Line__c =='MST'
                                                                   || case.Product_Line__c =='Pouch'|| case.Product_Line__c =='Dry Snuff'
                                                                   || case.Product_Line__c =='PMUSA Snus' || case.Product_Line__c =='USSTC Snus' 
                                                                   || case.Product_Line__c =='Loose Leaf' || case.Product_Line__c =='Dry Snuff' 
                                                                   || case.Product_Line__c =='TOBACCO DERIVED NICOTINE POUCH' ),true, false)}">
                </apex:pageBlockSectionItem> -->
                <apex:outputField value="{!case.Date_Code__c}" id="datecode" rendered="{!case.Product_Line__c=='MST'||case.Product_Line__c=='Pouch'||case.Product_Line__c=='Dry Snuff'|| case.Product_Line__c=='PMUSA Snus'|| case.Product_Line__c=='USSTC Snus' ||case.Product_Line__c=='Loose Leaf' }"/>
                
                <apex:outputField value="{!case.Machine_Code__c}" id="machineCode" rendered="{!IF(case.Product_Line__c=='Cigars' || case.Product_Line__c=='TOBACCO DERIVED NICOTINE POUCH'      
                                                                                             || case.Product_Line__c=='Dry Snuff' || case.Product_Line__c=='Pouch' || case.Product_Line__c=='MST'
                                                                                             || case.Product_Line__c=='USSTC Snus',true,false)}"/>                                                                                  
                
                <apex:outputField value="{!case.Exp_Date__c}" id="ExpDate"   rendered="{!IF(case.Product_Line__c=='Green Smoke E-Vapor',true,false)}"/>
                <apex:outputField value="{!case.DNUA_Date__c}" id="dnuaDate"  rendered="{!IF(case.Product_Line__c=='E-Cigarette',true,false)}"/>
                
                <apex:pageBlockSectionItem id="section9" rendered="{!IF((case.Product_Line__c=='Cigars' || case.Product_Line__c=='Dry Snuff'
                                                                    || case.Product_Line__c=='E-Cigarette' || case.Product_Line__c=='Green Smoke E-Vapor'
                                                                    || case.Product_Line__c=='TOBACCO DERIVED NICOTINE POUCH' || case.Product_Line__c=='Tobacco-Derived Nicotine Product'),true, false)}">
                </apex:pageBlockSectionItem>
                
                <apex:outputField value="{!case.ProdrReturnReq__c}" label="Product Return Required for Reimbursement"/>
                
                <apex:outputField value="{!case.Confirmed_Counterfeit__c}" label="Confirmed Counterfeit"/> 
                
                <!-- <apex:pageBlockSectionItem id="section2" rendered="{!IF(NOT(case.Product_Line__c =='MST'|| case.Product_Line__c =='Pouch'|| case.Product_Line__c =='Dry Snuff'|| case.Product_Line__c =='PMUSA Snus'|| case.Product_Line__c =='USSTC Snus' ||case.Product_Line__c =='Loose Leaf' ),true, false)}">
                </apex:pageBlockSectionItem> -->
                
                <apex:outputText label="Date" value="{0,date,MM/dd/yyyy}" rendered="{!IF((case.Product_Line__c =='MST'|| case.Product_Line__c =='Pouch'|| case.Product_Line__c =='Dry Snuff'|| case.Product_Line__c =='PMUSA Snus'|| case.Product_Line__c =='USSTC Snus' ||case.Product_Line__c =='Loose Leaf' ),true, false)}">
                    <apex:param value="{!case.Date__c}" /> 
                </apex:outputText>
                <apex:outputField value="{!case.Outbound_Tracking__c}" label="Outbound Tracking #"/>
                
                <apex:pageBlockSectionItem id="section3" rendered="{!IF(NOT(case.Product_Line__c =='MST'|| case.Product_Line__c =='Pouch'|| case.Product_Line__c =='Dry Snuff'|| case.Product_Line__c =='PMUSA Snus' || case.Product_Line__c =='USSTC Snus' ||case.Product_Line__c =='Loose Leaf' ),true, false)}">
                </apex:pageBlockSectionItem>
                <apex:outputField value="{!case.Date_Type__c}" id="datetype" rendered="{!case.Product_Line__c=='MST'||case.Product_Line__c=='Pouch'||case.Product_Line__c=='Dry Snuff'|| case.Product_Line__c=='PMUSA Snus'|| case.Product_Line__c=='USSTC Snus' ||case.Product_Line__c=='Loose Leaf' }"/>
                
                <apex:outputField value="{!case.Inbound_Tracking__c}" label="Inbound Tracking #"/> 
                
                <apex:pageBlockSectionItem id="sell1" rendered="{!IF(NOT(case.Brandcode__c =='COPENHAGEN'),true,false)}"></apex:pageBlockSectionItem>
                
                <apex:outputField value="{!case.Update_Reason__c}" label="Update Reason" rendered="{!isUpdateReasonVisible}"/>
                
                <apex:outputField value="{!case.ThirdPartyContacted__c}" id="ThirdParty" rendered="{!If(case.Classificationtxt__c=='APE',true,false)}"/>
                
            </apex:pageBlockSection>
            
            <apex:pageBlockSection showHeader="false"> 
                <apex:outputField value="{!case.Consumer_Mentions__c}" label="Consumer Mentions"/>
                <apex:outputField value="{!case.Related_Issue__c}" label="Related Issue"/>
                <apex:outputPanel ></apex:outputPanel>     
            </apex:pageBlockSection>
            
            <apex:pageBlockSection showHeader="false"> 
                <apex:outputText value=" " label=" " />
                <apex:outputField value="{!case.NMI_Transaction_ID__c}" label="NMI Transaction ID"/>
                <apex:outputPanel ></apex:outputPanel>     
            </apex:pageBlockSection>
            
            <apex:pageBlockSection title="Trade Customer" id="TradeCustomer" rendered="{!If(customerRecType!='consumer',true,false)}">
                <apex:outputField value="{!Case.Inventory_Depleted__c}" label="Depleted Inventory"/>
                <apex:outputField value="{!Case.Caller_Name__c}" label="Caller Name"/>
                <apex:outputField value="{!Case.Consumer_Return__c}" label="Consumer Return"/> 
                <apex:outputField value="{!Case.Supplier_Name__c}" label="Supplier Name"/>
                <apex:outputField value="{!Case.Comments__c}" label="Consumer Return Comments"/>
            </apex:pageBlockSection>            
            
            <apex:pageBlockSection title="Comment" columns="1">
                <apex:outputPanel layout="block">
                    <table class="detailList" width="100%">
                        <tr>
                            <td class="labelCol" style="text-align:right; width:5%;">Comment</td>
                            <td class="dataCol" style="text-align:left; font-weight:normal;">
                                <apex:outputText value="{!case.Comment__c}"
                                                style="white-space:pre-wrap;" />
                            </td>
                        </tr>
                    </table>
                </apex:outputPanel>
            </apex:pageBlockSection>
            
            <apex:pageBlockSection columns="2" title="System Information">                
                <apex:outputField value="{!case.CreatedDate__c}" label="Created Date"/>                
                <apex:outputField value="{!case.LastModifiedDate__c}" label="Last Modified Date"/>
                <apex:outputField value="{!case.CreatedByName__c}" label="Created By"/>
                <apex:outputField value="{!case.LastModifiedByName__c}" label="Last Modified By"/>
                <apex:outputField value="{!case.IsReviewed__c}"/>
                <apex:outputField value="{!case.ExtractFromFeed__c}" rendered="false"/>
                <apex:selectList id="caseStatus" value="{!selectedStatus}" size="1" label="Status">
                    <apex:actionSupport event="onchange" action="{!UpdateStatus}" />
                    <apex:selectOptions value="{!StatusOptions}"/>
                </apex:selectList>
            </apex:pageBlockSection>
            <apex:inputHidden id="refreshTag"/>
            
            <apex:pageBlockSection columns="1" title="Email">
                <apex:commandButton value="New Email" onclick="newEmail();" />
                <apex:pageBlockTable value="{!Case.EmailMessages}" var="email"  onRowClick="clickElem(this);" styleClass="caseId">
                    <apex:column value="{!email.MessageDate}" headerValue="Message Date and Time" />
                    <apex:column headerValue="Subject" >
                        <apex:outputLink value="/{!email.Id}"><apex:outputText value="{!email.Subject}" /></apex:outputLink>
                    </apex:column>
                    <apex:column value="{!email.FromName}" headerValue="From Name"  />
                    <apex:column value="{!email.FromAddress}" headerValue="From Address"  />
                    <apex:column value="{!email.Status}" headerValue="Status"  />
                </apex:pageBlockTable>
            </apex:pageBlockSection>   
            <div class="slds-grid slds-wrap slds-grid_align-center slds-m-vertical_medium">
            <apex:commandButton action="{!edit}" value="Edit" rendered="{!currentTran != null}"/>
            <!-- <apex:commandButton value="Edit" onclick="editIssue(); return false;" rendered="{!currentTran != null}" /> -->
            <apex:commandButton value="Reimbursement" onclick="reimbursement();return false;" rendered="{!If(customerRecType == 'consumer' && currentTran != null && country == $Label.Country,true,false)}"/>
            <apex:commandButton value="New Store" onclick="newStore();return false" rendered="{!currentTran != null}" disabled="{!isStoreEmpty}"/>
            <apex:commandButton value="Clone" action="{!customClone}" onclick="openClonePage();return false" rendered="{!currentTran != null}"/>
            <apex:commandButton value="{!If(custId == '',(if(customerRecType == 'consumer','New Consumer','New Trade Customer')),(if(customerRecType == 'consumer','Consumer','Trade Customer')))}" onclick="openConsumer('{!If(custId == '', 'No Contact','Contact')}');return false" rendered="{!currentTran != null}"/>
            <apex:commandButton value="Update Survey" onclick="openSurvey();return false" rendered="{!If(isSurveyApplicable != null && isSurveyApplicable != '' && isSurveyApplicable != 'Required' && isSurveyApplicable != 'Not Applicable' && currentTran != null,true,false)}"/>
            <apex:commandButton value="Survey" styleClass="NewSurvey" style="" onclick="openSurvey();return false" rendered="{!If(isSurveyApplicable == 'Required' && currentTran != null ,true,false)}"/>
            <apex:commandButton value="Attach File" onclick="openAttachment(); return false" rendered="{!currentTran != null}"/>
            <apex:commandButton value="Online VF"  action="{!submitVF}" onclick="if (!confirmsend()) return false;" rendered="{!case.Contact.Email != null}"/>
            <apex:commandButton value="Refresh" onclick="refreshCurrentPage(); return false"  rendered="{!currentTran != null}"/>
            <apex:commandButton value="End call" onclick="openPrimaryTabEndCall();return false" rendered="{!currentTran != null}"/>
            <apex:commandButton value="Resend Survey" action="{!ResendSurvey}"  rendered="{!if(caseObj.IsReviewed__c == true && hasSurvey,true,false)}"/>
        </div>            
        </apex:pageblock>  
             
    </apex:form>
    
    <!-- <apex:relatedList list="EmailMessages" id="Emails"/> -->

    <apex:pageBlock title="Stores" id="storeBlock">
        <apex:pageBlockTable value="{!case.stores__r}" var="st">
            <apex:column headerValue="Action">
                <apex:outputLink value="/apex/StoreEditPage?id={!st.Id}&amp;IssueId={!$CurrentPage.parameters.id}" style="color:#0070d2;">Edit</apex:outputLink>
                &nbsp;|&nbsp;
                <a href="#" onclick="deleteRecord('{!st.Id}', 'Store__c'); return false;" style="color:#0070d2;">Del</a>
            </apex:column>
            <apex:column headerValue="Store Code">
                <apex:outputLink value="/apex/StoreDetail?id={!st.Id}" style="color:#0070d2;">{!st.Name}</apex:outputLink>
            </apex:column>
            <apex:column value="{!st.Store_Name__c}" headerValue="Store Name"/>
            <apex:column value="{!st.Store_Type__c}" headerValue="Store Type"/>
            <apex:column value="{!st.Store_City__c}" headerValue="Store City"/>
            <apex:column value="{!st.Store_Address1__c}" headerValue="Store Address1"/>
            <apex:column value="{!st.Store_State__c}" headerValue="Store State"/>
        </apex:pageBlockTable>
    </apex:pageBlock>
    
    <apex:pageBlock title="Reimbursements" id="reimbursementBlock">

        <apex:pageBlockTable value="{!case.Reimbursements__r}" var="rb">
            <apex:column headerValue="Action">
                <apex:outputLink value="/apex/ReimbursementEdit?id={!rb.Id}&amp;IssueId={!$CurrentPage.parameters.id}" style="color:#0070d2;">Edit</apex:outputLink>
                &nbsp;|&nbsp;
                <a href="#" onclick="deleteRecord('{!rb.Id}', 'Reimbursement__c'); return false;" style="color:#0070d2;">Del</a>
            </apex:column>    
            <apex:column headerValue="Reimbursement Name">
                <apex:outputLink value="/apex/ReimbursementDetail?id={!rb.Id}" style="color:#0070d2;">{!rb.Name}</apex:outputLink>
            </apex:column>
            <apex:column value="{!rb.Reimbursement_Type__c}" headerValue="Reimbursement Type"/>
            <apex:column value="{!rb.Cheque_Amount__c}" headerValue="Check Amount"/>
        </apex:pageBlockTable>
    </apex:pageBlock>

    <apex:pageBlock title="Survey" id="surveyList">           
        <apex:outputPanel rendered="{!(IssueSurvyeList.size <=0)}">
            No records to display
        </apex:outputPanel>
        <apex:pageBlockTable value="{!IssueSurvyeList}" var="sn" rendered="{!(IssueSurvyeList.size >0)}">
            <apex:column headerValue="Survey Name">
                <apex:OutputText value="{!sn.Survey_Name__c}"/>
            </apex:column>
            <apex:column headerValue="Question">
                <apex:OutputText value="{!sn.QuestionText__c}"/>
            </apex:column>
            <apex:column headerValue="Answer">
                <apex:OutputText value="{!sn.AnswerText__c }"/>
            </apex:column>               
            <apex:column headerValue="Comments">
                <apex:OutputText value="{!sn.Comment__c}"/>
            </apex:column>            
        </apex:pageBlockTable>
        <br/>
        <apex:outputPanel rendered="{!(IssueSurvyeList.size >4)}">
            <a href="#" onclick="OpenSubtabSurvey();return false;">View complete Survey List</a>
        </apex:outputPanel>
    </apex:pageBlock>
    <apex:pageBlock title="Attachments" id="att">
        <apex:outputPanel rendered="{!attachList.size<=0}">
            No Record to display.
        </apex:outputPanel>
        <apex:pageBlockTable value="{!attachList}" var="attList" rendered="{!attachList.size>0}">
            <apex:column headerValue="Action">
                <a href="/servlet/servlet.FileDownload?file={!attList.id}" target="_blank">View File</a>
            </apex:column>
            <apex:column headerValue="File Name">
                <apex:outputLink onClick="attchmentDetail('{!attList.id}','{!attList.Name}');return false;" style="cursor:pointer; color:#0070d2; text-decoration:underline;" rendered="{!currentTran != null}">{!attList.Name}</apex:outputLink>
                <apex:OutputText value="{!attList.Name}" rendered="{!currentTran == null}"/>
            </apex:column>
            <apex:column headerValue="Comment">
                <apex:OutputText value="{!attList.description}" />
            </apex:column>
            <apex:column headerValue="Created Date">
                <apex:OutputText value="{!attList.CreatedDateEST}" />
            </apex:column> 
            <apex:column headerValue="Last Modified Date">
                <apex:OutputText value="{!attList.LastModifiedDateEST}" />
            </apex:column>
        </apex:pageBlockTable>
    </apex:pageBlock>
    <apex:pageBlock id="ChatHistId" title="Messaging Sessions" rendered="{!NOT(ISNULL(chatHistory)) && chatHistory.size > 0}">
    <apex:pageBlockTable value="{!chatHistory}" var="ms" rows="20">
        <apex:column value="{!ms.Messaging_ID__c}" headerValue="Messaging ID"/>
        <apex:column value="{!ms.CreatedDate}" headerValue="Created Date"/>
        <apex:column value="{!ms.CreatedBy.Name}" headerValue="Created By"/>
        <apex:column value="{!ms.StartTime}" headerValue="Start Time"/>
        <apex:column value="{!ms.EndTime}" headerValue="End Time"/>    
        <apex:column value="{!ms.LastModifiedDate}" headerValue="Last Modified Date"/>
        <apex:column value="{!ms.LastModifiedBy.Name}" headerValue="Last Modified By"/>
    </apex:pageBlockTable>
    <apex:outputLabel value="No records to display"
                      rendered="{!ISNULL(chatHistory) || chatHistory.size = 0}"/>
    </apex:pageBlock>
</apex:page>