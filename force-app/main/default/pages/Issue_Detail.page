            function newEmail() {
                var issueId       = '{!JSENCODE($CurrentPage.parameters.id)}';
                var toAddress     = '{!JSENCODE(Case.Contact.Email)}';
                var fromAddress   = 'crcphoto@altriacrc.com';
                var currentUserEmail = '{!JSENCODE($User.Email)}';

                // Go straight to the standard Send Email action (Case.Send_Email).
                // Routing through Case.SendEmailLWC opened a ScreenAction modal that
                // stayed behind the composer, so we skip that hop entirely and pass the
                // same prefill values the LWC used to supply.
                //
                // defaultFieldValues is a comma separated list of Field=Value pairs,
                // URL encoded exactly once - the same payload encodeDefaultFieldValues()
                // produces in LWC.
                // Every recipient/body field is sent EXPLICITLY, blank ones included.
                // Omitting them lets the composer apply its own defaults, which quotes
                // the Case's previous EmailMessage into the body and repopulates
                // Cc/Bcc. Passing an empty value is what forces a clean compose window.
                var defaults = [
                    'RelatedToId=' + issueId,
                    'ValidatedFromAddress=' + fromAddress,
                    'ToAddress=' + (toAddress || ''),
                    'CcAddress=' ,
                    'BccAddress=' + (currentUserEmail || ''),
                    'HtmlBody=',
                    'TextBody='
                ];
                // No backgroundContext param on purpose: leaving it off keeps this
                // Visualforce page behind the modal, so Send/Cancel returns here.
                var url = '/lightning/action/quick/Case.Send_Email'
                        + '?recordId=' + encodeURIComponent(issueId)
                        + '&defaultFieldValues=' + encodeURIComponent(defaults.join(','));
                if (typeof sforce !== 'undefined' && sforce.one) {
                    sforce.one.navigateToURL(url);
                } else {
                    window.top.location.href = url;
                }
            }

