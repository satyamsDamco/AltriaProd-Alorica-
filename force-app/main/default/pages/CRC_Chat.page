<apex:page showHeader="false" sidebar="false" standardStylesheets="false" docType="html-5.0">
<html>
<head>
    <title>CRC Chat</title>

    <style type="text/css">
        body,td,th,div,p,h1,h2,h3,h4,h5,h6,label,input,select,textarea,button{font-family:Arial,Helvetica,sans-serif}
        body,td{color:#4c4b4a;font-size:12px}
        body{margin:0;padding:0}
        table{width:400px;}
        .cb-header{background-color:#221f1f;padding:0 10px; height: 44px}
        .cb-header img{width: 114px;margin-top: 11px;margin-left: 11px}
        h1{font-size:14px;font-weight:bold;margin:0;padding:0;line-height:1.4}
        h2{font-size:12px;font-weight:bold;margin:0;padding:0}
        h3{font-size:18px;display:block;text-align:justify;font-weight:bold;margin:0;padding:0}
        p{margin:0 0 8px 0;padding:0;font-size:12px;line-height:1.4}
        input[type="text"]{font-size:14px;border-radius:0;background-color:#faf9f7;border-color:#e5e2e0;padding-top:5px;padding-bottom:5px;box-shadow:none;border:1px solid #ccc;width:99%}
        .cb-red-color{color:#c13145}
        .cb-required:after{content:"*";position:absolute;color:#c13145;font-size:1em;margin-left:3px}
        label{width:max-content;float:left;margin-bottom:0;line-height:30px}
        label[for="Category"]{width:100%}
        .control-input{margin-bottom:7px;width:73%;float:right}
        .control-input.category{width:99%;float:right}
        form table{margin:0 15px}
        select{padding-top:5px;padding-bottom:5px;border:1px solid #ccc;background-color:#faf9f7;width:100%;border-radius:0}
        input[type="button"]{background-color:#0a9ee9;background:-webkit-gradient(linear,left top,left bottom,from(#0a9ee9),to(#0884e3));background:-webkit-linear-gradient(top,#0a9ee9 0%,#0884e3 100%);background:-moz-linear-gradient(top,#0a9ee9 0%,#0884e3 100%);background:-ms-linear-gradient(top,#0a9ee9 0%,#0884e3 100%);color:#fff;font-family:HelveticaNeueBold,"Helvetica Neue Bold",Helvetica,Arial,sans-serif;text-shadow:0 -1px 0 rgba(0,0,0,0.3);padding:12px 32px;font-size:14px;border-radius:0;border:0;font-weight:700}
        input[type="button"]:hover,input[type="button"]:focus,input[type="button"]:active{cursor:pointer;color:#fff;background-color:#087bc4;border-color:transparent;background-image:none}
        .blank_row{height: 10px !important;background-color: #FFFFFF;}
        .popup{position:absolute;z-index:501;top: 10%;left: 15%;bottom:10%;width: 70%;padding: 6px;}
        .popupbackground{position:absolute;z-index: 500;top:0px;left:0px;width: 100%;height: 100%;}
    </style>

    <script type="text/javascript">
        var isEmbeddedMessagingReady = false;

        window.addEventListener("onEmbeddedMessagingReady", function () {
            isEmbeddedMessagingReady = true;
            console.log("Enhanced Messaging Ready");
        });

        // Agent-ended and visitor-ended chats both funnel into handleChatEnded().
        // onEmbeddedMessagingSessionStatusUpdate covers the agent ending the chat;
        // the conversation-ended events and the widget postMessage below cover the
        // visitor ending it from the widget menu. The chatHasEnded guard makes the
        // extra listeners harmless - whichever signal arrives first wins.
        var chatHasEnded = false;

        function onConversationEnded(source) {
            if (chatHasEnded) {
                return;
            }
            chatHasEnded = true;
            console.log("[CRC_Chat] conversation ended - signal:", source);
            handleChatEnded();
        }

        function readSessionStatus(detail) {
            if (!detail) {
                return null;
            }
            if (detail.sessionStatus) {
                return detail.sessionStatus;
            }
            if (!detail.conversationEntry) {
                return null;
            }
            var payload = detail.conversationEntry.entryPayload;
            if (typeof payload === "string") {
                payload = JSON.parse(payload);
            }
            return payload ? payload.sessionStatus : null;
        }

        window.addEventListener("onEmbeddedMessagingSessionStatusUpdate", function (event) {
            console.log("[CRC_Chat] onEmbeddedMessagingSessionStatusUpdate fired:", event.detail);
            try {
                var status = readSessionStatus(event.detail);
                if (status === "Ended" || status === "Closed") {
                    onConversationEnded("sessionStatusUpdate:" + status);
                }
            } catch (e) {
                // Payload shape can vary by bootstrap version; log instead of failing silently.
                console.error("Unable to parse session status payload:", e, event.detail);
            }
        });

        ["onEmbeddedMessagingConversationEnded",
         "onEmbeddedMessagingConversationClosed",
         "onEmbeddedMessagingConversationDeactivated"].forEach(function (eventName) {
            window.addEventListener(eventName, function () {
                onConversationEnded(eventName);
            });
        });

        // Fallback for bundles that only report a visitor-ended chat through the
        // widget iframe's postMessage channel. Scoped to the production chat host's
        // origin so unrelated page messages can never trigger the ended-chat overlay.
        window.addEventListener("message", function (event) {
            if (!event.origin || event.origin.indexOf("altria-prod.my.site.com") === -1) {
                return;
            }
            var raw = typeof event.data === "string" ? event.data : JSON.stringify(event.data || "");
            if (/CONVERSATION_ENDED|ConversationEnded|conversationEnded|END_CONVERSATION/.test(raw)) {
                onConversationEnded("postMessage");
            }
        });

        function handleChatEnded() {
            // Show the blocking overlay immediately so there's no gap where the
            // (now-ended) input is still reachable while clearSession resolves.
            document.getElementById("chatEndedPanel").style.display = "block";

            // Stop re-sending prechat data before wiping the form, then reset the
            // fields so the next visitor starts from a clean form.
            stopPrechatRefresh();
            clearPrechatForm();

            // hideChat() only affects the collapsed launcher BUTTON and is a no-op
            // while a conversation window is open. clearSession() is what actually
            // closes the window and resets the widget to its initial page-load state.
            resetMessagingWidget("chat ended");
        }

        function resetMessagingWidget(context) {
            try {
                return embeddedservice_bootstrap.userVerificationAPI.clearSession()
                    .catch(function (error) {
                        console.error("clearSession failed (" + context + "):", error);
                    });
            } catch (e) {
                console.error("clearSession threw (" + context + "):", e);
                return null;
            }
        }

        function startNewConversation() {
            document.getElementById("chatEndedPanel").style.display = "none";
            chatHasEnded = false;

            // Guarantee the widget is back to its initial state so the next launch
            // opens a brand-new MessagingSession instead of resuming the ended one.
            resetMessagingWidget("start new conversation");

            // The form is cleared when a chat ends, so launching straight from here
            // would create a MessagingSession with no prechat data. Return the visitor
            // to the empty form instead - CHAT NOW validates and starts the new chat.
            clearPrechatForm();
            window.scrollTo(0, 0);

            var prefix = document.getElementById("Prefix");
            if (prefix) {
                prefix.focus();
            }
        }

        function alphaOnly(event) {
            var key = event.keyCode;
            return (
                (key >= 65 && key <= 90) ||
                (key >= 35 && key <= 40) ||
                key === 8 ||
                key === 32 ||
                key === 189 ||
                key === 9 ||
                key === 46
            );
        }

        function getAge(dateString) {
            var today = new Date();
            var birthDate = new Date(dateString);
            var age = today.getFullYear() - birthDate.getFullYear();
            var m = today.getMonth() - birthDate.getMonth();

            if (m < 0 || (m === 0 && today.getDate() <= birthDate.getDate())) {
                age--;
            }

            return age;
        }

        function formatDobForSalesforce(isoDate) {
            // <input type="date"> always submits "YYYY-MM-DD" regardless of the
            // browser's display locale; convert to MM/DD/YYYY for Salesforce.
            var parts = isoDate.split("-");
            if (parts.length !== 3) {
                return isoDate;
            }
            return parts[1] + "/" + parts[2] + "/" + parts[0];
        }

        function buildPrechatFields() {
            return {
                "Prefix": document.getElementById("Prefix").value,
                "FirstName": document.getElementById("FirstName").value.trim(),
                "LastName": document.getElementById("LastName").value.trim(),
                "StreetAddress": document.getElementById("StreetAddress").value.trim(),
                "AptSuiteOther": document.getElementById("AptSuiteOther").value.trim(),
                "ZipCode": document.getElementById("ZipCode").value.trim(),
                "DateOfBirth": formatDobForSalesforce(document.getElementById("DateOfBirth").value),
                "Subject": document.getElementById("Subject").value.trim(),
                "ReasonOrQuestion": document.getElementById("Subject").value.trim()
            };
        }

        var prechatRefreshTimer = null;

        // Re-assert the hidden prechat fields periodically so a conversation
        // started from the widget's built-in "New Conversation" button still
        // carries the form data instead of creating a blank MessagingSession.
        function startPrechatRefresh() {
            if (prechatRefreshTimer) {
                return;
            }
            prechatRefreshTimer = window.setInterval(function () {
                if (isEmbeddedMessagingReady && window.embeddedservice_bootstrap && embeddedservice_bootstrap.prechatAPI) {
                    embeddedservice_bootstrap.prechatAPI.setHiddenPrechatFields(buildPrechatFields());
                }
            }, 10000);
        }

        // Must run before the form is cleared, otherwise the interval would push
        // empty values to the widget and the next conversation would be blank.
        function stopPrechatRefresh() {
            if (prechatRefreshTimer) {
                window.clearInterval(prechatRefreshTimer);
                prechatRefreshTimer = null;
            }
        }

        function clearPrechatForm() {
            ["FirstName", "LastName", "StreetAddress", "AptSuiteOther", "ZipCode", "DateOfBirth", "Subject"]
                .forEach(function (id) {
                    var field = document.getElementById(id);
                    if (field) {
                        field.value = "";
                        field.setCustomValidity("");
                    }
                });

            var prefix = document.getElementById("Prefix");
            if (prefix) {
                prefix.selectedIndex = 0;
                prefix.setCustomValidity("");
            }
        }

        function validatePrechatForm() {
            var prefix = document.getElementById("Prefix");
            var firstName = document.getElementById("FirstName");
            var lastName = document.getElementById("LastName");
            var streetAddress = document.getElementById("StreetAddress");
            var zipCode = document.getElementById("ZipCode");
            var dob = document.getElementById("DateOfBirth");
            var subject = document.getElementById("Subject");

            // Visualforce strips the empty value="" attribute from the placeholder
            // option, so its value falls back to its text. Validate against the
            // real prefixes instead of relying on an empty value.
            var validPrefixes = ["Mr.", "Ms.", "Mrs."];
            prefix.setCustomValidity(validPrefixes.indexOf(prefix.value) !== -1 ? "" : "Please select a Prefix.");
            firstName.setCustomValidity(firstName.value.trim() ? "" : "Please enter your First Name.");

            if (!lastName.value.trim()) {
                lastName.setCustomValidity("Please enter your Last Name.");
            } else if (!/^(\D{2,})$/.test(lastName.value.trim())) {
                lastName.setCustomValidity("Please ensure that your entry for Last Name is at least 2 characters long.");
            } else {
                lastName.setCustomValidity("");
            }

            streetAddress.setCustomValidity(streetAddress.value.trim() ? "" : "Please enter your Street Address.");

            if (!zipCode.value.trim()) {
                zipCode.setCustomValidity("Please enter your ZIP Code.");
            } else if (!/^(\d{5})$/.test(zipCode.value.trim())) {
                zipCode.setCustomValidity("Please enter your ZIP Code, it must be 5 numbers long.");
            } else {
                zipCode.setCustomValidity("");
            }

            if (!dob.value.trim()) {
                dob.setCustomValidity("Please enter your Date of Birth.");
            } else if (getAge(dob.value) <= 20) {
                dob.setCustomValidity("According to federal law, you are underage.");
            } else {
                dob.setCustomValidity("");
            }

            subject.setCustomValidity(subject.value.trim() ? "" : "Please enter your Reason or Question.");
        }

        function openEnhancedChat() {
            validatePrechatForm();

            var form = document.getElementById("prechatForm");
            if (!form.checkValidity()) {
                form.reportValidity();
                return false;
            }

            if (["Mr.", "Ms.", "Mrs."].indexOf(document.getElementById("Prefix").value) === -1) {
                alert("Please select a Prefix before starting the chat.");
                return false;
            }

            if (
                !window.embeddedservice_bootstrap ||
                !embeddedservice_bootstrap.prechatAPI ||
                !embeddedservice_bootstrap.utilAPI ||
                !isEmbeddedMessagingReady
            ) {
                alert("Chat is still loading. Please try again in a few seconds.");
                console.error("Enhanced Messaging is not ready.");
                return false;
            }

            var prechatFields = buildPrechatFields();

            console.log("Sending Hidden Prechat Fields:", JSON.stringify(prechatFields));

            embeddedservice_bootstrap.prechatAPI.setHiddenPrechatFields(prechatFields);
            startPrechatRefresh();

            embeddedservice_bootstrap.utilAPI.launchChat()
                .catch(function(error) {
                    console.error("Error opening Enhanced Chat:", error);
                    alert("Unable to open chat. Please try again.");
                });

            return false;
        }

        function initEmbeddedMessaging() {
            try {
                embeddedservice_bootstrap.settings.language = "en_US";

                // Hide the default "Ask Me Anything" launcher so the only way to
                // start a chat is the CHAT NOW button, which runs form validation.
                embeddedservice_bootstrap.settings.hideChatButtonOnLoad = true;

                // ---- PRODUCTION Embedded Messaging deployment ----
                embeddedservice_bootstrap.init(
                    "00D36000001EhVB",
                    "CRC_Chat",
                    "https://altria-prod.my.site.com/ESWCRCChat1784959947287",
                    {
                        scrt2URL: "https://altria-prod.my.salesforce-scrt.com"
                    }
                );
            } catch (err) {
                console.error("Error loading Embedded Messaging:", err);
            }
        }
    </script>
</head>

<body>
    <div id="chatEndedPanel" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.55); z-index:9999;">
        <div style="max-width:360px; margin:20% auto; background:#fff; border-radius:4px; padding:24px; text-align:center;">
            <h2 style="margin:0 0 12px;">The agent has ended the chat</h2>
            <p style="margin:0 0 16px;">This conversation is closed. Start a new one if you still need help.</p>
            <input type="button" id="startNewChatBtn" class="chat_button" value="Start New Conversation" onclick="startNewConversation();"/>
        </div>
    </div>

    <form id="prechatForm" onsubmit="return false;" style="height: 100%;width: 100%;">
        <table>
            <tr class="blank_row">
                <td colspan="3"></td>
            </tr>
            <tr>
                <td align="center">
                    <h3>Thank you for contacting our Consumer Response Center. Please fill in the details below to start your chat session.</h3>
                </td>
            </tr>
            <tr class="blank_row">
                <td colspan="3"></td>
            </tr>
            <tr>
                <td>
                    <label for="Prefix" class="cb-required">Prefix</label>
                    <div class="control-input">
                        <select id="Prefix" class="drop_list" required="true" title="Please select a Prefix.">
                            <option value="">Please select a Prefix.</option>
                            <option value="Mr.">Mr.</option>
                            <option value="Ms.">Ms.</option>
                            <option value="Mrs.">Mrs.</option>
                        </select>
                    </div>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="FirstName" class="cb-required">First Name:</label>
                    <div class="control-input">
                        <input type="text" id="FirstName" title="Please enter your First Name."
                               onkeydown="return alphaOnly(event);" required="true"/>
                    </div>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="LastName" class="cb-required">Last Name:</label>
                    <div class="control-input">
                        <input type="text" id="LastName" required="true"
                               title="Please ensure that your entry for Last Name is at least 2 characters long."
                               onkeydown="return alphaOnly(event);"/>
                    </div>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="StreetAddress" class="cb-required">Street Address:</label>
                    <div class="control-input">
                        <input type="text" id="StreetAddress" required="true" title="Please enter your Street Address."/>
                    </div>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="AptSuiteOther">APT/Suite/Other:</label>
                    <div class="control-input">
                        <input type="text" id="AptSuiteOther" title="APT/Suite/Other is optional"/>
                    </div>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="ZipCode" class="cb-required">ZIP CODE:</label>
                    <div class="control-input">
                        <input type="text" id="ZipCode" required="true"
                               title="Please enter your ZIP Code, it must be 5 numbers long; examples: 04007 or 75116."/>
                    </div>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="DateOfBirth" class="cb-required">Date of Birth:</label>
                    <div class="control-input">
                        <input type="date" placeholder="mm/dd/yyyy" id="DateOfBirth" required="true"
                               style="border: 1px solid rgb(204, 204, 204); border-image: none; padding-top: 5px;
                                      padding-bottom: 5px; font-size: 14px; background-color: rgb(250, 249, 247);"/>
                    </div>
                </td>
            </tr>
            <tr>
                <td>
                    <label style="line-height: 0px;">Format: mm/dd/yyyy</label>
                </td>
            </tr>
            <tr>
                <td>
                    <div class="control-input">
                        <h1>
                            Tobacco is an age restricted product. By providing your date of birth, you are certifying that you are of legal age to purchase tobacco in your locality.
                        </h1>
                    </div>
                </td>
            </tr>
            <tr>
                <td>
                    <label for="Subject" class="cb-required">Reason or Question:</label>
                </td>
            </tr>
            <tr>
                <td>
                    <textarea id="Subject" required="true" cols="80%" rows="3" maxlength="500"></textarea>
                </td>
            </tr>
            <tr class="blank_row">
                <td colspan="3"></td>
            </tr>
            <tr>
                <td>
                    <label class="cb-red-color"><strong>* = Required</strong></label>
                    <div>
                        <br/>
                        <br/>
                        <p>We will record, use, and retain the information you provide and the communications within the chat for the purposes of assisting you and improving our services. By continuing and using chat, you consent to this use of your personal information.</p>
                    </div>
                    <div align="right">
                        <input type="button" value="CHAT NOW" class="chat_button" id="prechat_submit" onclick="openEnhancedChat();"/>
                    </div>
                </td>
            </tr>
            <tr class="blank_row">
                <td colspan="3"></td>
            </tr>
            <tr>
                <td style="font-size: 100%;">
                    <h2 style="font-size: small;">
                        Our Consumer Response Center is available:<br/>
                        Monday through Friday from 9 a.m. to 7 p.m. EST.<br/>
                        Call 1-800-852-5847 for additional assistance.
                    </h2>
                </td>
            </tr>
        </table>
    </form>

    <!-- PRODUCTION bootstrap -->
    <script type="text/javascript"
            src="https://altria-prod.my.site.com/ESWCRCChat1784959947287/assets/js/bootstrap.min.js"
            onload="initEmbeddedMessaging()">
    </script>
</body>
</html>
</apex:page>