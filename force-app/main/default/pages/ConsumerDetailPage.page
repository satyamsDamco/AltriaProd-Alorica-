        <script type="text/javascript">
        
        // lifetime of the page (i.e., until this specific tab is reloaded)
        var CURRENT_TAB_ID = null;
        var pageLoad = window.onload;
        
        // Reference the standard Lightning Console Tab Focused message channel
        // Note: the channel name requires the "__c" suffix when imported in Visualforce
        var tabFocusedChannel = "{!$MessageChannel.lightning__tabFocused}";
        var subscription;
        
        window.onload = function() {
            if (pageLoad) {
                pageLoad();
            }
            
            hidingCloseLink();
            showProductReturnAlert();
            // history hide logic
            setTimeout(function(){
                var historyDiv = document.getElementById("historyList");
                
                if(historyDiv){
                    var text = historyDiv.innerText || '';
                    
                    // exact text match
                    if(text.includes("No records") || text.includes("NO RECORDS TO DISPLAY")){
                        historyDiv.style.display = "none";
                    }
                }
            }, 800);
            
            // Subscribe to the tab focused channel so this page can detect
            // when its own primary tab is (re)focused
            if (typeof sforce !== 'undefined' && sforce.one) {
                subscription = sforce.one.subscribe(tabFocusedChannel, handleTabClick, { scope: "APPLICATION" });
                console.log("Subscribed to tab focus events.");
            }
            
            if (typeof sforce !== 'undefined' && sforce.console) {
                sforce.console.getEnclosingPrimaryTabId(function(result) {
                    if (result.success) {
                        CURRENT_TAB_ID = result.id;
                        console.log("CURRENT_TAB_ID:" + CURRENT_TAB_ID);
                    }
                });
            }
        };
        
        // Handle the event when a tab is clicked/focused.
        // If it's this page's own primary tab being focused, refresh
        // immediately - same behaviour as the Issue Detail page.
        function handleTabClick(message) {
            if (message) {
                var currentTabId = message.currentTabId;
                var previousTabId = message.previousTabId;
                if (CURRENT_TAB_ID == currentTabId) {
                    caseListRefresh();   // AJAX refresh only - no full reload
                }
                
                console.log("Tab Clicked! Current Tab ID: " + currentTabId);
                console.log("Previous Tab ID: " + previousTabId);
                console.log("CURRENT_TAB_ID:" + CURRENT_TAB_ID);
            }
        }
        
        // Clean up the subscription if the page unloads
        var pageUnload = window.onunload;
        window.onunload = function() {
            if (pageUnload) {
                pageUnload();
            }
            if (subscription) {
                sforce.one.unsubscribe(subscription);
            }
        };
        
        function OpenSubtabCorres() {   // changed open in self tab so directly call CorrespondencePage
            
            var conid = '{!$CurrentPage.parameters.id}';
            var retURL = '{!JSENCODE($CurrentPage.parameters.retURL)}';
            
            var url = '/apex/CorrespondencePage?contid=' + conid +
                '&retURL=' + encodeURIComponent(retURL);
            
            if (typeof sforce !== 'undefined' && sforce.one) {
                sforce.one.navigateToURL(url);
            } else {
                window.open(url, '_self');
            }
        }
        
        function showProductReturnAlert(){
            
            var productReturnRequiredObj = document.getElementById("{!$Component.frm:pb11:pb13:ProductReturnRequired}");
            var val;
            
            if (productReturnRequiredObj != null) {
                val = productReturnRequiredObj.checked;
            }
            if(val !== "undefined"){
                if(val){
                    alert('Product Return is required for all reimbursements for this consumer.');
                }
                
            }
            
        }
        
        function hidingCloseLink(){
            
            var tds = document.getElementById("historyList").getElementsByTagName("td");
            for (var i = 0; i<tds.length; i++) {       
                if (tds[i].className == "actionColumn") {
                    var data = tds[i].innerHTML;
                    var EditLink = data.split('|');
                    tds[i].innerHTML = EditLink[0];                   
                }
            }
            
            var tds = document.getElementsByTagName("div");
            for (var i = 0; i<tds.length; i++) {       
                if (tds[i].className == "pShowMore") {
                    var data = tds[i].innerHTML;
                    var EditLink = data.split('|');
                    tds[i].innerHTML = EditLink[1];                   
                }
            }          
        }
        
        function subtabIssue() {
            var conid = '{!$CurrentPage.parameters.id}';
            var issue = document.getElementById("{!$Component.frm:issueNum}").value;
            var pageNumber = 0;
            
            if (issue == null || issue == 'null' || issue == '') {
                pageNumber = 1;
                document.getElementById("{!$Component.frm:issueNum}").value = 1;
            } else {
                pageNumber = issue;
                document.getElementById("{!$Component.frm:issueNum}").value = parseInt(issue) + 1;
            }
            
            // Lightning navigation (same tab)
            //var retURL = '{!JSENCODE($CurrentPage.parameters.retURL)}';
            var retURL = window.location.href;
            
            var url = '/apex/IssueEntryPage?pageNumber=' + pageNumber +
                '&contid=' + conid +
                '&retURL=' + encodeURIComponent(retURL);
            
            if (typeof sforce !== 'undefined' && sforce.one) {
                sforce.one.navigateToURL(url);
            } else {
                window.location.href = url;
            }
        }
        
        function openPrimaryTabEndCall(){
            var retURL = '{!JSENCODE($CurrentPage.parameters.retURL)}';
            //window.open('/apex/EndCall?retURL=' + encodeURIComponent(retURL), '_Self');
            sforce.one.navigateToURL('/apex/EndCall?retURL=' + encodeURIComponent(retURL));
        }
        
        var subTabConsumer = '';
        function currentTabRefresh() {
            if (subTabConsumer == '' || subTabConsumer == null) {
                subTabConsumer = '';
                caseListRefresh(); 
            }
        }
        
        var openSuccess = function openSuccess(result) {
            //Report whether we succeeded in opening the subtab
            
            if (result.success == true) {
                //alert('subtab successfully opened');
            } else {
                //alert('subtab cannot be opened');
            }
        };
        
        var onFocusedSubtabCallback = function (result) {
            var entityId = result.objectId;
            subTabConsumer =  result.id;
            if(document.getElementById("{!$Component.frm:pb11:btn:refresh1}") != null){
                document.getElementById("{!$Component.frm:pb11:btn:refresh1}").click();
            }else if(document.getElementById("{!$Component.frm:pbs2:btn1:refresh2}") != null){
                document.getElementById("{!$Component.frm:pbs2:btn1:refresh2}").click();
            }                        
        };  
        
        //   sforce.console.onFocusedSubtab(onFocusedSubtabCallback);
        
        var newWin=null;
        
        function openPrimaryTabAgeVerifyPage() {
            var contactId = '{!contact.Id}';
            var retURL = '{!JSENCODE($CurrentPage.parameters.retURL)}';
            
            var url = '/apex/ConsumerAgeVerification?id=' + contactId +
                '&retURL=' + encodeURIComponent(retURL);
            
            if (typeof sforce !== 'undefined' && sforce.one) {
                sforce.one.navigateToURL(url);
            } else {
                window.location.href = url;
            }
        }
        var openSubtabAgeVerify=function openSubtab(result) {
            var primaryTabId = result.id;
            sforce.console.openSubtab(primaryTabId,'/apex/ConsumerAgeVerification?id='+'{!contact.Id}', true, 'Age Verify', null, openSuccess );
        } 
        
        function hotzip() {
            
            alert('The ZIP code for the consumer belongs to one of the restricted Zip Codes. Please follow the verification guidelines specified.');
            var contactId = '{!conObj.Id}';
            var zipCode = '{!conObj.Zip_Code__c}';
            var retURL = '{!JSENCODE($CurrentPage.parameters.retURL)}';
            
            var url = '/apex/HotZip?contactId=' + contactId +
                '&zipcode=' + encodeURIComponent(zipCode) +
                '&retURL=' + encodeURIComponent(retURL);
            
            if (typeof sforce !== 'undefined' && sforce.one) {
                sforce.one.navigateToURL(url);
            } else {
                window.open(url, '_self');
            }
        }
        
        function reimbHist() {
            var contactId = '{!conObj.id}';
            var contactName = '{!conObj.LastName}';
            var zipCode = '{!conObj.Zip_Code__c}';
            
            var url = '/apex/ReimbursementHistory?contactId=' + contactId + '&retURL=' + encodeURIComponent('{!JSENCODE($CurrentPage.parameters.retURL)}');
            if (typeof sforce !== 'undefined' && sforce.one) {
                sforce.one.navigateToURL(url);
            } else {
                window.open(url, '_self');
            }
        }
        
        function editConsumer() {
            
            var consumerId = '{!conObj.Id}';
            
            if (consumerId && consumerId !== 'null') {
                
                var url = '/apex/ConsumerEntry?id=' + consumerId;
                
                if (typeof sforce !== 'undefined' && sforce.one) {
                    sforce.one.navigateToURL(url);
                } else {
                    window.open(url, '_self');
                }
            }
        }
        function deleteRecord(recordId, objectApiName) {
            if(confirm('Are you sure you want to delete this record?')) {
                var sessionId = '{!$Api.Session_ID}';
                var xhr = new XMLHttpRequest();
                xhr.open('DELETE', '/services/data/v39.0/sobjects/' + objectApiName + '/' + recordId, true);
                xhr.setRequestHeader('Authorization', 'Bearer ' + sessionId);
                xhr.setRequestHeader('Content-Type', 'application/json');
                xhr.onreadystatechange = function() {
                    if(xhr.readyState == 4) {
                        if(xhr.status == 204) {
                            location.reload();
                        } else {
                            alert('Delete failed. Status: ' + xhr.status + ' - ' + xhr.responseText);
                        }
                    }
                };
                xhr.send();
            }
        }
        
        </script>
