<apex:page standardController="Attachment" extensions="AttachmentDetail" lightningStyleSheets="true" standardStylesheets="false" >
<apex:slds />
    <apex:includeScript value="/support/console/62.0/integration.js" /> 
    <apex:sectionHeader title="{!Attachment.name}"/>
    <script>
    
    function CloseTab() {
        sforce.console.getEnclosingTabId(closeSubtab);
    }        
    var closeSubtab = function closeSubtab(result) {
        //Now that we have the tab ID, we can close it
        var tabId = result.id;
        sforce.console.closeTab(tabId);
    };
    </script>
  <apex:form enctype="multipart/form-data">
    <apex:pageMessages />
    <apex:pageBlock title="Attachment Detail" mode="View">
    <div class="slds-grid slds-grid_align-center slds-m-vertical_medium">
      <apex:commandButton value="Edit" action="{!editPage}" rendered="{!tranid != null}" />
    </div>

  <apex:pageBlockSection showHeader="false" columns="1" id="block1">
            <apex:outputField value="{!Attachment.name}">&nbsp; <a href="/servlet/servlet.FileDownload?file={!Attachment.id}" target="_blank">View file</a></apex:outputField>
            <apex:outputField value="{!Attachment.Description}" label="Comment"/>            
   </apex:pageBlockSection>
      <apex:pageBlockButtons location="bottom" style="text-align:center;">
        <apex:commandButton value="Edit" action="{!editPage}" rendered="{!tranid != null}" />
      </apex:pageBlockButtons>
    </apex:pageBlock>
  </apex:form>
</apex:page>