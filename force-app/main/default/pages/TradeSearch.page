        <apex:inputHidden id="issueNum" />
        <apex:pageBlock id="pb" title="Trade Customer Search">
            
            <apex:pageMessages id="messagePb"></apex:pageMessages>
            <div role="alert" style="display:none;" id="errorMessages"></div>
            <apex:actionFunction name="RefreshContact" action="{!RefreshTradeContact}"/>
            <apex:actionFunction name="GetFieldTrade" action="{!onCTISearch}"/>
            <apex:actionFunction name="TradeSearch"  action="{!TradeSearch}" rerender="messagePb"/>
            <!-- "Start" Changed to display button on top and botton inside page block by Sara -->
            <div class="slds-grid slds-grid_align-center slds-wrap slds-m-bottom_small" style="text-align:center; width:100%; display:flex; justify-content:center;">
                <apex:commandButton value="Search" action="{!TradeSearch}" id="btn1" disabled="{!If(selectedCustomerType != null || selectedCustomerType  != '' ,false,true)}" styleClass="slds-m-around_xx-small"/>
                <apex:commandButton value="New Issue" onclick="openPrimaryTabIssue();return false" id="btn2" disabled="{!If(selectedCustomerType != null || selectedCustomerType  != '' ,false,true)}" styleClass="slds-m-around_xx-small"/>
                <apex:commandButton value="{!If(tranObj.Contact__c == null ,'New Trade Customer','Trade Customer')}" onclick="openPrimaryTabTrade('{!If(tranObj.Contact__c == null, 'No Contact',tranObj.Contact__c)}');return false" disabled="{!isTradeBtnVisible}" id="btn3" styleClass="slds-m-around_xx-small"/>
                <apex:commandButton value="Clear" action="{!Clear}" id="btn4" disabled="{!If(tranObj.Contact__c == null ,false,true)}" styleClass="slds-m-around_xx-small"/>
                <apex:commandButton value="Refresh" onclick="currentTabRefresh(); return false" id="refresh" style="visibility: hidden;"/>
            </div>
            <apex:pageBlockButtons location="Bottom" style="text-align:center">
