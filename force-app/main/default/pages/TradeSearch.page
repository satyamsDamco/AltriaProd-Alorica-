                partID = document.getElementById("{!$Component.fm1:pb:pbs:r2}").value;
                blindCode = document.getElementById("{!$Component.fm1:pb:pbs:r3}").value;
                resCom = document.getElementById("{!$Component.fm1:pb:pbs:r4}").value;
                resLoc = document.getElementById("{!$Component.fm1:pb:pbs:r5}").value;
                proFlavType = document.getElementById("{!$Component.fm1:pb:pbs:r7}").value;
                rName = document.getElementById("{!$Component.fm1:pb:pbs:r8}").value;
            }
            
            if(custType != null && custType != '' && custType1 != null && custType1 != ''){
                parameters = parameters +    '&custType='+custType;
                parameters = parameters +    '&custType1='+custType1;
                
                if(issueNo != null && issueNo != '' && issueNo != 'null')
                    parameters = parameters +    '&issueNo='+issueNo;
                
                if(comName != null && comName != '' && comName != 'null')
                    parameters = parameters +    '&comName='+comName;
                
                if(DBA != null && DBA != '' && DBA != 'null')
                    parameters = parameters +    '&DBA='+DBA;
                
                if(phone != null && phone != '' && phone != 'null')
                    parameters = parameters +    '&phone='+phone;
                
                if(accountNo != null && accountNo != '' && accountNo != 'null')
                    parameters = parameters +    '&accountNo='+accountNo;
                
                if(retail != null && retail != '' && retail != 'null')
                    parameters = parameters +    '&retail='+retail;
                
                if(territory != null && territory != '' && territory != 'null')
                    parameters = parameters +    '&territory='+territory;
                
                if(fSphone != null && fSphone != '' && fSphone != 'null')
                    parameters = parameters +    '&fSphone='+fSphone;
                
                if(phone != null && phone != '' && phone != 'null')
                    parameters = parameters +    '&phone='+phone;
                
                if(agentName != null && agentName != '' && agentName != 'null')
                    parameters = parameters +    '&agentName='+agentName;
                
                if(email != null && email != '' && email != 'null')
                    parameters = parameters +    '&email='+email;
                
                if(zip != null && zip != '' && zip != 'null')
                    parameters = parameters +    '&zip='+zip;
                
                if(studyID != null && studyID != '' && studyID != 'null')
                    parameters = parameters +    '&studyID='+studyID;
                
                if(partID != null && partID != '' && partID != 'null')
                    parameters = parameters +    '&partID='+partID;
                
                if(blindCode != null && blindCode != '' && blindCode != 'null')
                    parameters = parameters +    '&blindCode='+blindCode;
                
                if(resCom != null && resCom != '' && resCom != 'null')
                    parameters = parameters +    '&resCom='+resCom;
                
                if(resLoc != null && resLoc != '' && resLoc != 'null')
                    parameters = parameters +    '&resLoc='+resLoc;
                
                if(proFlavType != null && proFlavType != '' && proFlavType != 'null')
                    parameters = parameters +    '&proFlavType='+proFlavType;
                
                if(rName != null && rName != '' && rName != 'null')
                    parameters = parameters +    '&rName='+rName;
            }    
            
            var url = '/apex/ConsumerEntry?x=x' + parameters;
            
            sforce.one.navigateToURL(url);
        };
        function openPrimaryTabIssue(){
            openSubtabIssue({ id: null });
        }
        
        var openSubtabIssue = function openSubtab(result) {
            
            var issue = document.getElementById("{!$Component.fm1:issueNum}").value;
            var pageNumber = 0;
            
            if(issue == null || issue == 'null'){
                pageNumber = 1;
                document.getElementById("{!$Component.fm1:issueNum}").value = 1;
            }else{
                pageNumber = issue;
                document.getElementById("{!$Component.fm1:issueNum}").value = issue +1;
            }
            
            var conid = '{!tranObj.Contact__c}';
            var parameters ='';
            var comName;   
            var DBA;
            var zip;
            var phone;
            var agentName;
            var accountNo;
            var retail;
            var email;
            var fSphone;
            var territory;
            var issueNo;
            var custType = '{!selectedCustomerType}';
            var custType1 = '{!selectedCustomerTypeId}';
            
            if(custType == "{!$Label.Wholesaler}"){ 
