        var CustomerName;    
        var CustomerId;
        
        function openCustomer(id, Name){
            CustomerName = Name;
            CustomerId = id;
            openCustomerData();                          
        }
        
        function openCustomerData(){            
            var url = '/apex/ConsumerEntry?from=search&id=' + CustomerId;
            sforce.one.navigateToURL(url);
        }
        var openSubtabCustomer = function(result) {
            
            var url = '/apex/ConsumerEntry?from=search&id=' + CustomerId;
            
            if (typeof sforce !== 'undefined' && sforce.console && result && result.id) {
                sforce.console.openSubtab(
                    result.id,
                    url,
                    true,
                    CustomerName,
                    null,
                    openSuccess,
                    'Trade'
                );
            } else {
                sforce.one.navigateToURL(url);
            }
        };
        
        
        var openSuccess = function openSuccess(result) {
            //Report whether we succeeded in opening the subtab
            if (result.success == true) {
                CustomerName = '';
                CustomerId =  '';
            } else {
            }
        };
        var subTabSearch = '';
        function currentTabRefresh() {
            if (typeof sforce !== 'undefined' && sforce.console) {
                sforce.console.getEnclosingTabId(refreshCurrentTab);
            } else {
                RefreshContact();
            }
        }
        var refreshCurrentTab = function refreshSubtab(result){
            var subTabId = result.id;
            if(subTabSearch == subTabId || subTabSearch.trim() == ''){
                subTabSearch = '';
                RefreshContact();
            }
        }
        var onFocusedSubtabCallback = function (result) {
            subTabSearch =  result.id;
            document.getElementById("{!$Component.fm1:pb:btn:refresh}").click();
        };
        if (typeof sforce !== 'undefined' && sforce.console) {
            sforce.console.isInConsole(function(res){
                if(res.isInConsole){
                    sforce.console.onFocusedSubtab(onFocusedSubtabCallback);
                }
            });
        }
        </script>
