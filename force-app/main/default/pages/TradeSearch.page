            }
            
            if(custType == "{!$Label.Retailer}"){
                retail = document.getElementById("{!$Component.fm1:pb:pbs:f7}").value;
                comName = document.getElementById("{!$Component.fm1:pb:pbs:f21}").value;
                if(document.getElementById("{!$Component.fm1:pb:pbs:f31}").value != ''){
                    DBA = document.getElementById("{!$Component.fm1:pb:pbs:f31}").value;
                }else{
                    DBA = document.getElementById("{!$Component.fm1:pb:pbs:f21}").value;
                }
                zip = document.getElementById("{!$Component.fm1:pb:pbs:f41}").value;
