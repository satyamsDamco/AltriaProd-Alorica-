                }
                zip = document.getElementById("{!$Component.fm1:pb:pbs:f4}").value;
                phone = document.getElementById("{!$Component.fm1:pb:pbs:f5}").value;
                issueNo = document.getElementById("{!$Component.fm1:pb:pbs:f11}").value;
            }
            
            if(custType == "{!$Label.Retailer}"){
                retail = document.getElementById("{!$Component.fm1:pb:pbs:f7}").value;
                comName = document.getElementById("{!$Component.fm1:pb:pbs:f21}").value;
                if(document.getElementById("{!$Component.fm1:pb:pbs:f31}").value != ''){
                    DBA = document.getElementById("{!$Component.fm1:pb:pbs:f31}").value;
                }else{
                    DBA = document.getElementById("{!$Component.fm1:pb:pbs:f21}").value;
                }
                zip = document.getElementById("{!$Component.fm1:pb:pbs:f41}").value;
                phone = document.getElementById("{!$Component.fm1:pb:pbs:f51}").value;
                issueNo = document.getElementById("{!$Component.fm1:pb:pbs:f12}").value;
            }
            
            if(custType == "{!$Label.Field_Sales_Force}"){
                agentName = document.getElementById("{!$Component.fm1:pb:pbs:f8}").value;
                email = document.getElementById("{!$Component.fm1:pb:pbs:f9}").value;
                fSphone = document.getElementById("{!$Component.fm1:pb:pbs:f13}").value;
                territory = document.getElementById("{!$Component.fm1:pb:pbs:f15}").value;
                issueNo = document.getElementById("{!$Component.fm1:pb:pbs:f14}").value;
            }
            
            if(custType != null && custType != '' && custType1 != null && custType1 != ''){
                parameters = parameters + '&custType='+custType;
                parameters = parameters + '&custType1='+custType1;
                
                if(issueNo != null && issueNo != '' && issueNo != 'null')
                    parameters = parameters + '&issueNo='+issueNo;
                
                if(comName != null && comName != '' && comName != 'null')
                    parameters = parameters + '&comName='+comName;
                
                if(DBA != null && DBA != '' && DBA != 'null')
                    parameters = parameters + '&DBA='+DBA;
                
                if(phone != null && phone != '' && phone != 'null')
                    parameters = parameters + '&phone='+phone;
                
                if(accountNo != null && accountNo != '' && accountNo != 'null')
                    parameters = parameters + '&accountNo='+accountNo;
                
                if(retail != null && retail != '' && retail != 'null')
                    parameters = parameters + '&retail='+retail;
                
                if(territory != null && territory != '' && territory != 'null')
                    parameters = parameters + '&territory='+territory;
                
                if(fSphone != null && fSphone != '' && fSphone != 'null')
                    parameters = parameters + '&fSphone='+fSphone;
                
                if(phone != null && phone != '' && phone != 'null')
                    parameters = parameters + '&phone='+phone;
                
                if(agentName != null && agentName != '' && agentName != 'null')
                    parameters = parameters + '&agentName='+agentName;
                
                if(email != null && email != '' && email != 'null')
                    parameters = parameters + '&email='+email;
                
                if(zip != null && zip != '' && zip != 'null')
                    parameters = parameters + '&zip='+zip;
            }
            
            var url;
            var retURL = encodeURIComponent(window.location.href);
            if(conid != null && conid != 'null' && conid != ''){
                url = '/apex/IssueEntryPage?pageNumber=' + pageNumber + '&contid=' + conid +'&retURL=' + retURL + parameters;
            } else {
                url = '/apex/IssueEntryPage?pageNumber=' + pageNumber +'&retURL=' + retURL + parameters;
