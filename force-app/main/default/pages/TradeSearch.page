        <script type="text/javascript">
        window.onload = function() {
            if (typeof sforce !== 'undefined' && sforce.console) {
                sforce.console.isInConsole(function(res){
                    if(res && res.isInConsole){
                        getPrimaryTabId();
                    }
                });
            }
        };
        
        function getPrimaryTabId(){
            document.cookie = 'apex__tranid={!tranid}; SameSite=None; Secure; path=/';
            if (typeof sforce !== 'undefined' && sforce.console) {
                sforce.console.getEnclosingPrimaryTabId(DisableTabCloseTrueWithId);
            }
        }
        var DisableTabCloseTrueWithId = function DisableTabCloseTrueWithId(result) {
            var primaryTabId = result.id;
            sforce.console.disableTabClose(false, primaryTabId);
        }
        function openPrimaryTabTrade(val){
            
            if(val == 'No Contact'){ 
                
                openSubtabTrade({ id: '' });
            }else{
                
                var CustomerId = val; 
                var url = '/apex/ConsumerDetailPage?id=' + CustomerId;
                
                sforce.one.navigateToURL(url);
            }    
        }
        var openSubtabTrade = function openSubtab(result) {
            var tranid= '{!tranid}';
            var parameters ='';
            var comName;   
            var DBA;
            var zip;
            var phone;
            var agentName;
            var accountNo;
            var retail;
            var email;
            var fSphone;
            var territory;
            var issueNo;
            var custType = '{!selectedCustomerType}';
            var custType1 = '{!selectedCustomerTypeId}';
            
            var studyID;
            var partID;
            var blindCode;
            var resCom;
            var resLoc;
            var proFlavType;
            var rName;
            
            if(custType == "{!$Label.Wholesaler}"){ 
